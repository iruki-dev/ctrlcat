---
import { getCollection } from "astro:content";
import ToolLayout from "../layouts/ToolLayout.astro";
import Icon from "../components/Icon.astro";
import { t, localePath, localize, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const tr = t(lang);

const allTools = await getCollection("tools", ({ data }) => data.status === "published");
allTools.sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title));
const categories = [...new Set(allTools.map((tool) => tool.data.category))].sort();

const activeClass = "bg-tool-accent text-tool-on-accent";
const inactiveClass = "bg-tool-surface text-tool-text-dim hover:bg-tool-surface-2 hover:text-tool-text";
---

<ToolLayout title={tr.tools.pageTitle} description={tr.tools.pageSubtitle} lang={lang} showHeader={false}>
  <div class="mb-8 border-b border-tool-border pb-6">
    <h1 class="text-2xl font-semibold text-tool-text">{tr.tools.pageTitle}</h1>
    <p class="text-sm text-tool-text-dim mt-1">{tr.tools.pageSubtitle}</p>
  </div>

  <div class="flex flex-col sm:flex-row gap-4 mb-6">
    <div class="relative flex-1 max-w-sm">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-tool-muted w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input
        id="tool-search"
        type="search"
        placeholder={tr.tools.search}
        class="w-full bg-tool-surface border border-tool-border text-tool-text text-sm pl-9 pr-3 py-2
               placeholder:text-tool-muted focus:outline-none focus:ring-2 focus:ring-tool-accent focus:border-tool-accent
               transition-colors"
      />
    </div>
    <div
      id="tool-filters"
      data-active-class={activeClass}
      data-inactive-class={inactiveClass}
      class="flex gap-0 flex-wrap border border-tool-border divide-x divide-tool-border overflow-hidden"
    >
      {["all", ...categories].map((cat) => (
        <button
          data-filter={cat}
          aria-pressed={String(cat === "all")}
          class:list={["px-3 py-2 text-xs font-medium transition-colors whitespace-nowrap", cat === "all" ? activeClass : inactiveClass]}
        >
          {cat === "all" ? tr.tools.all : tr.tools.categories_map[cat as keyof typeof tr.tools.categories_map]}
        </button>
      ))}
    </div>
  </div>

  <div id="tool-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-px bg-tool-border border border-tool-border">
    {allTools.map((tool) => {
      const { title, description } = localize(tool, lang);
      return (
        <a
          href={localePath(`/tools/${tool.slug}/`, lang)}
          data-category={tool.data.category}
          data-title={title.toLowerCase()}
          data-tags={tool.data.tags.join(" ").toLowerCase()}
          class="tool-card group flex flex-col gap-3 bg-tool-surface p-5
                 hover:bg-tool-accent-light transition-colors duration-150 focus:outline-none
                 focus:ring-2 focus:ring-inset focus:ring-tool-accent"
        >
          <div class="flex items-start justify-between gap-2">
            <span class="text-tool-accent"><Icon name={tool.data.icon} size={20} /></span>
            {tool.data.featured && (
              <span class="shrink-0 text-2xs px-1.5 py-0.5 border border-tool-accent/40 text-tool-accent bg-tool-accent/5 font-medium uppercase tracking-wide">
                {tr.tools.featured}
              </span>
            )}
          </div>
          <div class="flex-1">
            <div class="font-semibold text-sm text-tool-text group-hover:text-tool-accent transition-colors leading-snug">{title}</div>
            <div class="text-xs text-tool-text-dim mt-1.5 line-clamp-2 leading-relaxed">{description}</div>
          </div>
          <div class="flex items-center justify-between pt-2 border-t border-tool-border-dim">
            <div class="flex flex-wrap gap-1">
              {tool.data.tags.slice(0, 2).map((tag) => (
                <span class="text-2xs px-1.5 py-0.5 bg-tool-surface-2 text-tool-muted">{tag}</span>
              ))}
            </div>
            <span class="text-xs font-medium text-tool-accent group-hover:underline shrink-0">{tr.landing.useTool}</span>
          </div>
        </a>
      );
    })}
  </div>

  <div id="tool-empty" class="hidden py-20 text-center text-sm text-tool-muted">{tr.tools.noResults}</div>
</ToolLayout>

<script>
  import { initCatalogFilter } from "../scripts/catalogFilter";

  initCatalogFilter({
    searchId: "tool-search",
    gridId: "tool-grid",
    emptyId: "tool-empty",
    filtersId: "tool-filters",
    cardSelector: ".tool-card",
  });
</script>
