---
import { getCollection } from "astro:content";
import LandingLayout from "../layouts/LandingLayout.astro";
import Icon from "../components/Icon.astro";
import GameIllustration from "../components/GameIllustration.astro";
import { t, localePath, localize, locales, localeLabels, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const tr = t(lang);
const href = (path: string) => localePath(path, lang);

const byFeaturedThenTitle = (
  a: { data: { featured: boolean; title: string } },
  b: { data: { featured: boolean; title: string } },
) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title);

const allTools = (await getCollection("tools", ({ data }) => data.status === "published")).sort(byFeaturedThenTitle);
const allGames = (await getCollection("games", ({ data }) => data.status === "published")).sort(byFeaturedThenTitle);
const featuredTools = allTools.slice(0, 8);
const featuredGames = allGames.slice(0, 8);

const toolCategories = [...new Set(allTools.map((tool) => tool.data.category))].sort();
const gameCategories = [...new Set(allGames.map((game) => game.data.category))].sort();
const otherLocales = locales.filter((l) => l !== lang);
---

<LandingLayout lang={lang}>
  <header class="sticky top-0 z-40 bg-site-bg border-b border-site-border">
    <div class="max-w-6xl mx-auto px-4 h-14 flex items-center gap-6">
      <a href={href("/")} class="flex items-center gap-2 font-bold text-base tracking-tight shrink-0">
        <svg width="22" height="22" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="8" fill="#09090b"/>
          <path d="M9 21 L16 12 L23 21" stroke="#f8fafc" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="text-site-text">ctrl</span><span class="text-cyan-600">cat</span>
      </a>
      <nav class="flex items-center gap-1" aria-label={tr.nav.main}>
        <a href={href("/tools/")}
           class="px-3 py-1.5 text-sm font-medium text-site-text-dim hover:text-cyan-600 hover:bg-site-tool-hover rounded-md transition-colors">
          {tr.nav.tools}
        </a>
        <a href={href("/games/")}
           class="px-3 py-1.5 text-sm font-medium text-site-text-dim hover:text-violet-600 hover:bg-game-accent-light/40 rounded-md transition-colors">
          {tr.nav.games}
        </a>
      </nav>
      <div class="ml-auto flex items-center gap-2 text-xs">
        {locales.map((l) =>
          l === lang ? (
            <span class="px-2 py-1 rounded bg-site-border text-site-text font-medium">{localeLabels[l].long}</span>
          ) : (
            <a href={localePath("/", l)} data-locale={l} class="px-2 py-1 rounded text-site-text-dim hover:text-site-text hover:bg-site-border transition-colors">
              {localeLabels[l].long}
            </a>
          ),
        )}
      </div>
    </div>
  </header>

  <section class="bg-site-surface border-b border-site-border py-14 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-cyan-600 mb-3">ctrlcat.dev</p>
      <h1 class="text-3xl md:text-4xl font-bold text-site-text mb-3 tracking-tight leading-tight">{tr.landing.heroTitle}</h1>
      <p class="text-site-text-dim text-sm mb-8 max-w-md mx-auto">{tr.landing.heroSub}</p>

      <div class="relative max-w-xl mx-auto mb-6">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-site-muted w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input
          id="home-search"
          type="search"
          placeholder={tr.landing.searchPlaceholder}
          class="w-full bg-site-card border border-site-border-strong pl-11 pr-4 py-3
                 text-site-text placeholder:text-site-muted text-sm
                 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-all"
        />
      </div>

      <div class="flex flex-wrap justify-center gap-2">
        {toolCategories.map((cat) => (
          <a href={href(`/tools/?cat=${cat}`)}
             class="px-3 py-1 text-xs font-medium bg-site-card border border-site-border text-site-text-dim
                    hover:border-cyan-400 hover:text-cyan-600 transition-colors">
            {tr.tools.categories_map[cat]}
          </a>
        ))}
        <span class="px-2 py-1 text-site-muted text-xs self-center">|</span>
        {gameCategories.map((cat) => (
          <a href={href(`/games/?cat=${cat}`)}
             class="px-3 py-1 text-xs font-medium bg-site-card border border-site-border text-site-text-dim
                    hover:border-violet-400 hover:text-violet-600 transition-colors">
            {tr.games.categories_map[cat]}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12" id="section-tools" aria-label={tr.landing.featuredTools}>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-base font-semibold text-site-text uppercase tracking-wider">{tr.landing.featuredTools}</h2>
      <a href={href("/tools/")} class="text-sm text-site-tool hover:underline font-medium">{tr.landing.viewAllTools}</a>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-px bg-site-border border border-site-border">
      {featuredTools.map((tool) => {
        const { title, description } = localize(tool, lang);
        return (
          <a
            href={href(`/tools/${tool.slug}/`)}
            data-title={title.toLowerCase()}
            data-tags={tool.data.tags.join(" ").toLowerCase()}
            data-kind="tool"
            class="home-card group flex flex-col bg-site-card p-4 hover:bg-site-tool-hover transition-colors duration-150"
          >
            <div class="mb-3 text-site-tool"><Icon name={tool.data.icon} size={24} /></div>
            <div class="font-semibold text-sm text-site-text mb-1 leading-snug">{title}</div>
            <div class="text-xs text-site-text-dim line-clamp-2 leading-relaxed flex-1">{description}</div>
            <div class="mt-3 text-xs font-medium text-site-tool group-hover:underline">{tr.landing.useTool}</div>
          </a>
        );
      })}
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4">
    <div class="border-t border-site-border" />
  </div>

  <section class="max-w-6xl mx-auto px-4 py-12" id="section-games" aria-label={tr.landing.featuredGames}>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-base font-semibold text-site-text uppercase tracking-wider">{tr.landing.featuredGames}</h2>
      <a href={href("/games/")} class="text-sm text-game-accent hover:underline font-medium">{tr.landing.viewAllGames}</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featuredGames.map((game) => {
        const { title } = localize(game, lang);
        return (
          <a
            href={href(`/games/${game.slug}/`)}
            data-title={title.toLowerCase()}
            data-tags={game.data.tags.join(" ").toLowerCase()}
            data-kind="game"
            class="home-card group block rounded-3xl overflow-hidden bg-game-surface shadow-md-1 hover:shadow-md-3 transition-shadow duration-200"
          >
            <div class="flex items-center justify-center h-44 bg-game-bg">
              <GameIllustration slug={game.slug} />
            </div>
            <div class="px-5 py-4 border-t border-game-surface-2">
              <div class="font-bold text-sm text-game-text group-hover:text-game-accent transition-colors">{title}</div>
              <div class="flex items-center justify-between mt-1.5">
                {game.data.playTime && <span class="text-xs text-game-muted">{tr.games.playTime(game.data.playTime)}</span>}
                <span class="text-xs font-semibold text-game-accent group-hover:underline ml-auto">{tr.landing.playGame}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <footer class="bg-site-surface border-t border-site-border mt-4">
    <div class="max-w-6xl mx-auto px-4 py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
        <div class="col-span-2 md:col-span-1">
          <div class="font-bold text-base text-site-text mb-2">ctrl<span class="text-cyan-600">cat</span></div>
          <p class="text-xs text-site-text-dim leading-relaxed">{tr.landing.footerTagline}</p>
        </div>
        <div>
          <div class="text-xs font-semibold text-site-text uppercase tracking-wider mb-3">{tr.nav.tools}</div>
          <ul class="space-y-2">
            {allTools.slice(0, 5).map((tool) => (
              <li>
                <a href={href(`/tools/${tool.slug}/`)} class="text-xs text-site-text-dim hover:text-cyan-600 transition-colors">
                  {localize(tool, lang).title}
                </a>
              </li>
            ))}
            <li>
              <a href={href("/tools/")} class="text-xs text-site-tool hover:underline font-medium">{tr.landing.footerAllTools}</a>
            </li>
          </ul>
        </div>
        <div>
          <div class="text-xs font-semibold text-site-text uppercase tracking-wider mb-3">{tr.nav.games}</div>
          <ul class="space-y-2">
            {allGames.slice(0, 5).map((game) => (
              <li>
                <a href={href(`/games/${game.slug}/`)} class="text-xs text-site-text-dim hover:text-violet-600 transition-colors">
                  {localize(game, lang).title}
                </a>
              </li>
            ))}
            <li>
              <a href={href("/games/")} class="text-xs text-game-accent hover:underline font-medium">{tr.landing.footerAllGames}</a>
            </li>
          </ul>
        </div>
        <div>
          <div class="text-xs font-semibold text-site-text uppercase tracking-wider mb-3">{tr.landing.footerSite}</div>
          <ul class="space-y-2">
            {otherLocales.map((l) => (
              <li>
                <a href={localePath("/", l)} data-locale={l} class="text-xs text-site-text-dim hover:text-site-text transition-colors">{localeLabels[l].long}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="border-t border-site-border pt-6 text-center text-xs text-site-muted">
        &copy; {new Date().getFullYear()} ctrlcat.dev — {tr.landing.copyright}
      </div>
    </div>
  </footer>

  <div id="home-no-results" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 bg-site-text text-site-bg text-sm px-4 py-2 shadow-lg z-50">
    {tr.landing.noResults}
  </div>
</LandingLayout>

<script>
  const searchInput = document.getElementById("home-search") as HTMLInputElement;
  const toolSection = document.getElementById("section-tools")!;
  const gameSection = document.getElementById("section-games")!;
  const noResults = document.getElementById("home-no-results")!;
  const cards = document.querySelectorAll<HTMLAnchorElement>(".home-card");

  searchInput.addEventListener("input", () => {
    const q = searchInput.value.toLowerCase().trim();
    let tools = 0;
    let games = 0;
    cards.forEach((card) => {
      const match = !q || card.dataset.title!.includes(q) || card.dataset.tags!.includes(q);
      card.style.display = match ? "" : "none";
      if (match && card.dataset.kind === "tool") tools++;
      if (match && card.dataset.kind === "game") games++;
    });
    toolSection.style.display = tools > 0 ? "" : "none";
    gameSection.style.display = games > 0 ? "" : "none";
    noResults.classList.toggle("hidden", !q || tools + games > 0);
  });
</script>
