---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../i18n";
import { t, localePath, switchLocalePath } from "../../i18n";
import Icon from "../Icon.astro";

interface Props {
  tools: CollectionEntry<"tools">[];
  currentSlug?: string;
  lang: Locale;
  url: URL;
}

const { tools, currentSlug, lang, url } = Astro.props;
const tr = t(lang);

const categoryOrder = ["text", "math", "color", "data", "image", "developer", "productivity", "converter"];
const grouped = categoryOrder.reduce<Record<string, CollectionEntry<"tools">[]>>((acc, cat) => {
  const items = tools.filter(tool => tool.data.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {});

function getTitle(tool: CollectionEntry<"tools">) {
  return (tool.data.localizations?.[lang]?.title) ?? tool.data.title;
}
---

<!-- Carbon Design System: Left Navigation -->
<aside
  id="tool-sidebar"
  class="fixed top-0 left-0 h-full w-64 bg-tool-surface border-r border-tool-border z-50
         flex flex-col
         -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out"
>
  <!-- Shell header branding -->
  <div class="flex items-center gap-2 px-4 h-14 border-b border-tool-border bg-tool-surface shrink-0">
    <a
      href={localePath("/tools/", lang)}
      class="flex items-center gap-2 font-semibold text-sm hover:opacity-80 transition-opacity"
    >
      <svg width="18" height="18" viewBox="0 0 32 32" fill="none">
        <rect width="32" height="32" rx="0" fill="#161616"/>
        <path d="M9 18 L16 9 L23 18" stroke="#78a9ff" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"/>
        <line x1="10" y1="24" x2="22" y2="24" stroke="#78a9ff" stroke-width="2.5" stroke-linecap="square"/>
      </svg>
      <span class="text-tool-text">ctrl</span><span class="text-tool-accent">cat</span>
      <span class="text-tool-muted text-xs font-normal ml-0.5">tools</span>
    </a>
  </div>

  <!-- Carbon search field -->
  <div class="px-0 py-0 border-b border-tool-border shrink-0">
    <div class="relative">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-tool-muted w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input
        id="sidebar-search"
        type="search"
        placeholder={tr.tools.search}
        class="w-full bg-tool-surface-2 dark:bg-tool-surface border-0 text-tool-text text-sm pl-11 pr-4 py-3
               placeholder:text-tool-muted focus:outline-none focus:ring-2 focus:ring-inset focus:ring-tool-accent
               transition-colors"
      />
    </div>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 overflow-y-auto scrollbar-hide" aria-label="Tools navigation">

    <!-- All Tools link -->
    <a
      href={localePath("/tools/", lang)}
      class:list={[
        "flex items-center gap-3 px-4 py-3 text-sm font-medium border-l-[3px] transition-colors",
        !currentSlug
          ? "border-l-tool-accent bg-tool-accent-light text-tool-accent"
          : "border-l-transparent text-tool-text-dim hover:text-tool-text hover:bg-tool-surface-2",
      ]}
    >
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
        <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
        <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
      </svg>
      {tr.nav.allTools}
    </a>

    <div class="border-t border-tool-border-dim mx-0 my-1" />

    <!-- Category groups -->
    {Object.entries(grouped).map(([cat, items]) => (
      <div class="mb-0" data-sidebar-group>
        <!-- Category heading — Carbon "divider" style -->
        <button
          class="sidebar-cat-toggle w-full flex items-center justify-between px-4 py-2
                 text-2xs font-semibold uppercase tracking-widest text-tool-muted
                 hover:bg-tool-surface-2 transition-colors"
          aria-expanded="true"
        >
          <span>{tr.tools.categories_map[cat as keyof typeof tr.tools.categories_map] ?? cat}</span>
          <svg class="toggle-icon w-3 h-3 opacity-50 transition-transform" viewBox="0 0 12 12" fill="currentColor">
            <path d="M2 4l4 4 4-4"/>
          </svg>
        </button>
        <div class="sidebar-cat-items">
          {items.map(tool => (
            <a
              href={localePath(`/tools/${tool.slug}/`, lang)}
              data-sidebar-item
              data-title={getTitle(tool).toLowerCase()}
              data-tags={tool.data.tags.join(" ").toLowerCase()}
              class:list={[
                "flex items-center gap-3 px-4 py-2.5 text-sm border-l-[3px] transition-colors",
                tool.slug === currentSlug
                  ? "border-l-tool-accent bg-tool-accent-light text-tool-accent font-medium"
                  : "border-l-transparent text-tool-text-dim hover:text-tool-text hover:bg-tool-surface-2",
              ]}
            >
              <span class:list={["shrink-0", tool.slug === currentSlug ? "text-tool-accent" : "text-tool-muted"]}>
                <Icon name={tool.data.icon ?? ""} size={16} />
              </span>
              <span class="truncate">{getTitle(tool)}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </nav>

  <!-- Footer: language switcher + theme toggle -->
  <div class="px-4 py-3 border-t border-tool-border shrink-0 bg-tool-surface">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-1 text-xs">
        <span class="text-tool-muted mr-1 text-xs">Lang</span>
        {(["en", "ko"] as Locale[]).map((l) => (
          <a
            href={switchLocalePath(url, l)}
            class:list={[
              "px-2 py-0.5 text-xs transition-colors",
              l === lang
                ? "bg-tool-accent text-white font-medium"
                : "text-tool-muted hover:text-tool-text-dim",
            ]}
          >
            {l === "en" ? "EN" : "KO"}
          </a>
        ))}
      </div>
      <!-- Theme toggle -->
      <button
        class="theme-toggle w-7 h-7 flex items-center justify-center
               text-tool-muted hover:text-tool-text hover:bg-tool-surface-2 transition-colors"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
      >
        <svg class="theme-icon-light" width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="square">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg class="theme-icon-dark hidden" width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="square">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>
    </div>
  </div>
</aside>

<!-- Mobile overlay -->
<div
  id="tool-sidebar-overlay"
  class="fixed inset-0 bg-black/60 z-40 hidden lg:hidden"
/>

<script>
  const sidebar = document.getElementById("tool-sidebar")!;
  const overlay = document.getElementById("tool-sidebar-overlay")!;
  const menuBtn = document.getElementById("sidebar-menu-btn");

  function openSidebar() {
    sidebar.classList.remove("-translate-x-full");
    overlay.classList.remove("hidden");
  }
  function closeSidebar() {
    sidebar.classList.add("-translate-x-full");
    overlay.classList.add("hidden");
  }

  menuBtn?.addEventListener("click", openSidebar);
  overlay.addEventListener("click", closeSidebar);

  document.querySelectorAll<HTMLButtonElement>(".sidebar-cat-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const items = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector<HTMLElement>(".toggle-icon");
      const collapsed = items.style.display === "none";
      items.style.display = collapsed ? "" : "none";
      if (icon) icon.style.transform = collapsed ? "" : "rotate(-90deg)";
      btn.setAttribute("aria-expanded", String(collapsed));
    });
  });

  const searchInput = document.getElementById("sidebar-search") as HTMLInputElement;
  const allItems = document.querySelectorAll<HTMLAnchorElement>("[data-sidebar-item]");

  searchInput?.addEventListener("input", () => {
    const q = searchInput.value.toLowerCase().trim();
    allItems.forEach((item) => {
      const match = !q || item.dataset.title?.includes(q) || item.dataset.tags?.includes(q);
      item.style.display = match ? "" : "none";
    });
  });
</script>
