---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../i18n";
import { t, localePath, switchLocalePath } from "../../i18n";
import Icon from "../Icon.astro";

interface Props {
  games: CollectionEntry<"games">[];
  currentSlug?: string;
  lang: Locale;
  url: URL;
}

const { games, currentSlug, lang, url } = Astro.props;
const tr = t(lang);

const categoryOrder = ["puzzle", "arcade", "strategy", "word", "number", "card", "trivia"];
const grouped = categoryOrder.reduce<Record<string, CollectionEntry<"games">[]>>((acc, cat) => {
  const items = games.filter(g => g.data.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {});

function getTitle(game: CollectionEntry<"games">) {
  return (game.data.localizations?.[lang]?.title) ?? game.data.title;
}
---

<aside
  id="game-sidebar"
  class="fixed top-0 left-0 h-full w-64 bg-game-bg border-r border-game-border-dim z-50
         flex flex-col
         -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out"
>
  <!-- Logo -->
  <div class="flex items-center gap-2 px-4 h-14 border-b border-game-border-dim shrink-0">
    <a
      href={localePath("/games/", lang)}
      class="flex items-center gap-1.5 font-bold text-base tracking-tight hover:opacity-80 transition-opacity"
    >
      <span class="text-game-text">ctrl</span><span class="text-game-accent">cat</span>
      <span class="text-game-muted text-xs font-normal ml-0.5">games</span>
    </a>
  </div>

  <!-- Search -->
  <div class="px-3 py-3 border-b border-game-border-dim shrink-0">
    <div class="relative">
      <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-game-muted text-xs select-none">⌕</span>
      <input
        id="sidebar-game-search"
        type="search"
        placeholder={tr.games.search}
        class="w-full bg-game-surface border border-game-border text-game-text text-sm rounded-md pl-7 pr-3 py-1.5
               placeholder:text-game-muted focus:outline-none focus:ring-1 focus:ring-game-accent focus:border-game-accent
               transition-colors"
      />
    </div>
  </div>

  <!-- Nav -->
  <nav class="flex-1 overflow-y-auto py-2 scrollbar-hide">

    <a
      href={localePath("/games/", lang)}
      class:list={[
        "flex items-center gap-2 mx-2 px-2 py-1.5 rounded-md text-sm transition-colors",
        !currentSlug
          ? "bg-game-surface text-game-text font-medium"
          : "text-game-muted hover:text-game-text hover:bg-game-surface",
      ]}
    >
      <span class="opacity-60">≡</span>
      {tr.nav.allGames}
    </a>

    <div class="mx-2 my-2 border-t border-game-border-dim" />

    {Object.entries(grouped).map(([cat, items]) => (
      <div class="mb-1">
        <button
          class="game-cat-toggle w-full flex items-center justify-between px-2 py-1 text-2xs font-semibold uppercase tracking-widest text-game-muted hover:text-game-text-dim transition-colors"
          aria-expanded="true"
        >
          <span>{tr.games.categories_map[cat as keyof typeof tr.games.categories_map] ?? cat}</span>
          <span class="toggle-icon opacity-40 transition-transform">▾</span>
        </button>
        <div class="game-cat-items">
          {items.map(game => (
            <a
              href={localePath(`/games/${game.slug}/`, lang)}
              data-game-item
              data-title={getTitle(game).toLowerCase()}
              data-tags={game.data.tags.join(" ").toLowerCase()}
              class:list={[
                "flex items-center gap-2 mx-0 px-2 py-1 rounded-md text-sm transition-colors",
                game.slug === currentSlug
                  ? "bg-game-surface text-game-accent font-medium"
                  : "text-game-muted hover:text-game-text hover:bg-game-surface/60",
              ]}
            >
              <span class="shrink-0 text-game-muted"><Icon name={game.data.icon ?? ""} size={16} /></span>
              <span class="truncate">{getTitle(game)}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </nav>

  <!-- Language switcher -->
  <div class="px-3 py-3 border-t border-game-border-dim shrink-0">
    <div class="flex items-center gap-1 text-xs">
      <span class="text-game-muted mr-1 text-xs">Lang</span>
      {(["en", "ko"] as Locale[]).map((l) => (
        <a
          href={switchLocalePath(url, l)}
          class:list={[
            "px-2 py-0.5 rounded transition-colors",
            l === lang
              ? "bg-game-surface text-game-text font-medium"
              : "text-game-muted hover:text-game-text-dim",
          ]}
        >
          {l === "en" ? "EN" : "한국어"}
        </a>
      ))}
    </div>
  </div>
</aside>

<div
  id="game-sidebar-overlay"
  class="fixed inset-0 bg-black/60 z-40 hidden lg:hidden backdrop-blur-sm"
/>

<script>
  const sidebar = document.getElementById("game-sidebar")!;
  const overlay = document.getElementById("game-sidebar-overlay")!;
  const menuBtn = document.getElementById("sidebar-menu-btn");

  menuBtn?.addEventListener("click", () => {
    sidebar.classList.remove("-translate-x-full");
    overlay.classList.remove("hidden");
  });
  overlay.addEventListener("click", () => {
    sidebar.classList.add("-translate-x-full");
    overlay.classList.add("hidden");
  });

  document.querySelectorAll<HTMLButtonElement>(".game-cat-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const items = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector<HTMLElement>(".toggle-icon");
      const collapsed = items.style.display === "none";
      items.style.display = collapsed ? "" : "none";
      if (icon) icon.style.transform = collapsed ? "" : "rotate(-90deg)";
    });
  });

  const searchInput = document.getElementById("sidebar-game-search") as HTMLInputElement;
  document.querySelectorAll<HTMLAnchorElement>("[data-game-item]").forEach((item) => {
    searchInput?.addEventListener("input", () => {
      const q = searchInput.value.toLowerCase().trim();
      const match = !q || item.dataset.title?.includes(q) || item.dataset.tags?.includes(q);
      item.style.display = match ? "" : "none";
    });
  });
</script>
