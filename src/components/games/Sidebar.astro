---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../i18n";
import { t, localePath, switchLocalePath } from "../../i18n";
import Icon from "../Icon.astro";

interface Props {
  games: CollectionEntry<"games">[];
  currentSlug?: string;
  lang: Locale;
  url: URL;
}

const { games, currentSlug, lang, url } = Astro.props;
const tr = t(lang);

const categoryOrder = ["puzzle", "arcade", "strategy", "word", "number", "card", "trivia"];
const grouped = categoryOrder.reduce<Record<string, CollectionEntry<"games">[]>>((acc, cat) => {
  const items = games.filter(g => g.data.category === cat);
  if (items.length > 0) acc[cat] = items;
  return acc;
}, {});

function getTitle(game: CollectionEntry<"games">) {
  return (game.data.localizations?.[lang]?.title) ?? game.data.title;
}
---

<!-- Material Design 3: Navigation Drawer -->
<aside
  id="game-sidebar"
  class="fixed top-0 left-0 h-full w-64 bg-game-surface border-r border-game-border-dim z-50
         flex flex-col
         -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out"
>
  <!-- Navigation Drawer header -->
  <div class="flex items-center gap-3 px-6 h-16 shrink-0">
    <a
      href={localePath("/games/", lang)}
      class="flex items-center gap-2 font-bold text-sm hover:opacity-80 transition-opacity"
    >
      <svg width="18" height="18" viewBox="0 0 32 32" fill="none">
        <rect width="32" height="32" rx="8" fill="#1c1b1f"/>
        <path d="M9 18 L16 9 L23 18" stroke="#d0bcff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="16" cy="24" r="3" stroke="#d0bcff" stroke-width="2.5"/>
      </svg>
      <span class="text-game-text font-medium">ctrl</span><span class="text-game-accent font-medium">cat</span>
      <span class="text-game-muted text-xs font-normal ml-0.5">games</span>
    </a>
  </div>

  <!-- MD3 search field -->
  <div class="px-3 pb-3 shrink-0">
    <div class="relative">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-game-muted w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input
        id="sidebar-game-search"
        type="search"
        placeholder={tr.games.search}
        class="w-full bg-game-surface-2 text-game-text text-sm rounded-full pl-11 pr-4 py-2.5
               placeholder:text-game-muted border-0 focus:outline-none focus:ring-2 focus:ring-game-accent
               transition-colors"
      />
    </div>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 overflow-y-auto py-1 scrollbar-hide px-3" aria-label="Games navigation">

    <!-- All Games — MD3 active indicator pill -->
    <a
      href={localePath("/games/", lang)}
      class:list={[
        "flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-[28px] transition-colors mb-0.5",
        !currentSlug
          ? "bg-game-accent-light text-game-accent"
          : "text-game-text-dim hover:bg-game-text/[.08] hover:text-game-text",
      ]}
    >
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
        <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
      </svg>
      {tr.nav.allGames}
    </a>

    <!-- Section divider -->
    <div class="my-2 border-t border-game-border-dim mx-2" />

    {Object.entries(grouped).map(([cat, items]) => (
      <div class="mb-1">
        <!-- Category label -->
        <button
          class="game-cat-toggle w-full flex items-center justify-between px-4 py-1.5
                 text-2xs font-semibold uppercase tracking-widest text-game-muted
                 hover:text-game-text-dim rounded-xl transition-colors"
          aria-expanded="true"
        >
          <span>{tr.games.categories_map[cat as keyof typeof tr.games.categories_map] ?? cat}</span>
          <svg class="toggle-icon w-3 h-3 opacity-50 transition-transform" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 4l4 4 4-4"/>
          </svg>
        </button>
        <div class="game-cat-items">
          {items.map(game => (
            <a
              href={localePath(`/games/${game.slug}/`, lang)}
              data-game-item
              data-title={getTitle(game).toLowerCase()}
              data-tags={game.data.tags.join(" ").toLowerCase()}
              class:list={[
                "flex items-center gap-3 px-4 py-2.5 text-sm rounded-[28px] transition-colors mb-0.5",
                game.slug === currentSlug
                  ? "bg-game-accent-light text-game-accent font-medium"
                  : "text-game-text-dim hover:bg-game-text/[.08] hover:text-game-text",
              ]}
            >
              <span class:list={["shrink-0", game.slug === currentSlug ? "text-game-accent" : "text-game-muted"]}>
                <Icon name={game.data.icon ?? ""} size={16} />
              </span>
              <span class="truncate">{getTitle(game)}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </nav>

  <!-- Footer: language switcher + theme toggle -->
  <div class="px-4 py-4 border-t border-game-border-dim shrink-0">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-1 text-xs">
        <span class="text-game-muted mr-1 text-xs">Lang</span>
        {(["en", "ko"] as Locale[]).map((l) => (
          <a
            href={switchLocalePath(url, l)}
            class:list={[
              "px-3 py-1 rounded-full text-xs transition-colors",
              l === lang
                ? "bg-game-accent-light text-game-accent font-semibold"
                : "text-game-muted hover:bg-game-text/[.08] hover:text-game-text-dim",
            ]}
          >
            {l === "en" ? "EN" : "KO"}
          </a>
        ))}
      </div>
      <!-- Theme toggle -->
      <button
        class="theme-toggle w-9 h-9 flex items-center justify-center rounded-full
               text-game-text-dim hover:bg-game-text/[.08] transition-colors"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
      >
        <svg class="theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg class="theme-icon-dark hidden" width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>
    </div>
  </div>
</aside>

<!-- MD3 scrim overlay (semi-transparent) -->
<div
  id="game-sidebar-overlay"
  class="fixed inset-0 bg-black/40 z-40 hidden lg:hidden"
/>

<script>
  const sidebar = document.getElementById("game-sidebar")!;
  const overlay = document.getElementById("game-sidebar-overlay")!;
  const menuBtn = document.getElementById("sidebar-menu-btn");

  menuBtn?.addEventListener("click", () => {
    sidebar.classList.remove("-translate-x-full");
    overlay.classList.remove("hidden");
  });
  overlay.addEventListener("click", () => {
    sidebar.classList.add("-translate-x-full");
    overlay.classList.add("hidden");
  });

  document.querySelectorAll<HTMLButtonElement>(".game-cat-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const items = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector<HTMLElement>(".toggle-icon");
      const collapsed = items.style.display === "none";
      items.style.display = collapsed ? "" : "none";
      if (icon) icon.style.transform = collapsed ? "" : "rotate(-90deg)";
      btn.setAttribute("aria-expanded", String(collapsed));
    });
  });

  const searchInput = document.getElementById("sidebar-game-search") as HTMLInputElement;
  document.querySelectorAll<HTMLAnchorElement>("[data-game-item]").forEach((item) => {
    searchInput?.addEventListener("input", () => {
      const q = searchInput.value.toLowerCase().trim();
      const match = !q || item.dataset.title?.includes(q) || item.dataset.tags?.includes(q);
      item.style.display = match ? "" : "none";
    });
  });
</script>
