---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

{slug === "number-guesser" && (
  <svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <!-- Soft outer glow -->
    <circle cx="100" cy="80" r="72" fill="#f5f3ff"/>
    <!-- Target rings -->
    <circle cx="100" cy="80" r="62" fill="#ede9fe"/>
    <circle cx="100" cy="80" r="47" fill="#c4b5fd"/>
    <circle cx="100" cy="80" r="32" fill="#8b5cf6"/>
    <circle cx="100" cy="80" r="16" fill="#6d28d9"/>
    <!-- Center dot -->
    <circle cx="100" cy="80" r="5" fill="white"/>
    <!-- Ring separators (subtle stroke) -->
    <circle cx="100" cy="80" r="62" fill="none" stroke="white" stroke-width="1.5" opacity="0.6"/>
    <circle cx="100" cy="80" r="47" fill="none" stroke="white" stroke-width="1.5" opacity="0.5"/>
    <circle cx="100" cy="80" r="32" fill="none" stroke="white" stroke-width="1.5" opacity="0.4"/>
    <!-- Crosshair ticks -->
    <line x1="100" y1="5" x2="100" y2="16" stroke="#5b21b6" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="100" y1="144" x2="100" y2="155" stroke="#5b21b6" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="26" y1="80" x2="37" y2="80" stroke="#5b21b6" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="163" y1="80" x2="174" y2="80" stroke="#5b21b6" stroke-width="2.5" stroke-linecap="round"/>
    <!-- Small arrow/pin pointing to center from top-right -->
    <line x1="136" y1="44" x2="107" y2="73" stroke="#4c1d95" stroke-width="2" stroke-linecap="round"/>
    <polygon points="107,73 113,66 120,75" fill="#4c1d95"/>
  </svg>
)}

{slug === "snake" && (
  <svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <!-- Board background -->
    <rect width="200" height="160" fill="#f5f3ff"/>
    <rect x="30" y="20" width="140" height="120" rx="8" fill="#faf8ff" stroke="#e4e0f8" stroke-width="1.5"/>
    <!-- Grid lines (subtle, 7×6 cells at 20px) -->
    <line x1="50" y1="20" x2="50" y2="140" stroke="#ede9fe" stroke-width="0.75"/>
    <line x1="70" y1="20" x2="70" y2="140" stroke="#ede9fe" stroke-width="0.75"/>
    <line x1="90" y1="20" x2="90" y2="140" stroke="#ede9fe" stroke-width="0.75"/>
    <line x1="110" y1="20" x2="110" y2="140" stroke="#ede9fe" stroke-width="0.75"/>
    <line x1="130" y1="20" x2="130" y2="140" stroke="#ede9fe" stroke-width="0.75"/>
    <line x1="150" y1="20" x2="150" y2="140" stroke="#ede9fe" stroke-width="0.75"/>
    <line x1="30" y1="40" x2="170" y2="40" stroke="#ede9fe" stroke-width="0.75"/>
    <line x1="30" y1="60" x2="170" y2="60" stroke="#ede9fe" stroke-width="0.75"/>
    <line x1="30" y1="80" x2="170" y2="80" stroke="#ede9fe" stroke-width="0.75"/>
    <line x1="30" y1="100" x2="170" y2="100" stroke="#ede9fe" stroke-width="0.75"/>
    <line x1="30" y1="120" x2="170" y2="120" stroke="#ede9fe" stroke-width="0.75"/>
    <!-- Snake body: S-curve, 7 segments (tail→head, light→dark violet) -->
    <!-- Tail (col5,row2)=(130,60): rect(132,62,16,16) -->
    <rect x="132" y="62" width="16" height="16" rx="3" fill="#ddd6fe"/>
    <!-- (col4,row2)=(110,60) -->
    <rect x="112" y="62" width="16" height="16" rx="3" fill="#c4b5fd"/>
    <!-- (col3,row2)=(90,60) -->
    <rect x="92" y="62" width="16" height="16" rx="3" fill="#a78bfa"/>
    <!-- Turn (col2,row2)=(70,60) -->
    <rect x="72" y="62" width="16" height="16" rx="3" fill="#8b5cf6"/>
    <!-- (col2,row3)=(70,80) -->
    <rect x="72" y="82" width="16" height="16" rx="3" fill="#7c3aed"/>
    <!-- (col3,row3)=(90,80) -->
    <rect x="92" y="82" width="16" height="16" rx="3" fill="#6d28d9"/>
    <!-- Head (col4,row3)=(110,80): facing right -->
    <rect x="112" y="82" width="16" height="16" rx="4" fill="#5b21b6"/>
    <!-- Eyes on head (right side, facing right) -->
    <circle cx="125" cy="87" r="2.5" fill="white"/>
    <circle cx="125" cy="93" r="2.5" fill="white"/>
    <circle cx="126" cy="87" r="1.2" fill="#2e1065"/>
    <circle cx="126" cy="93" r="1.2" fill="#2e1065"/>
    <!-- Food (col5,row4): center=(140,110) -->
    <circle cx="140" cy="110" r="8" fill="#db2777"/>
    <circle cx="137" cy="107" r="2.5" fill="rgba(255,255,255,0.45)"/>
  </svg>
)}

{slug === "tic-tac-toe" && (
  <svg viewBox="0 0 200 160" width="200" height="160" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <!-- Board background -->
    <rect x="20" y="12" width="160" height="136" rx="14" fill="#faf5ff"/>
    <rect x="20" y="12" width="160" height="136" rx="14" fill="none" stroke="#ede9fe" stroke-width="1.5"/>
    <!-- Grid lines -->
    <line x1="73" y1="22" x2="73" y2="138" stroke="#c4b5fd" stroke-width="2" stroke-linecap="round"/>
    <line x1="127" y1="22" x2="127" y2="138" stroke="#c4b5fd" stroke-width="2" stroke-linecap="round"/>
    <line x1="30" y1="57" x2="170" y2="57" stroke="#c4b5fd" stroke-width="2" stroke-linecap="round"/>
    <line x1="30" y1="103" x2="170" y2="103" stroke="#c4b5fd" stroke-width="2" stroke-linecap="round"/>
    <!-- Winning diagonal highlight -->
    <line x1="47" y1="35" x2="153" y2="125" stroke="#c084fc" stroke-width="28" stroke-linecap="round" opacity="0.12"/>
    <!-- X at top-left (47, 35) -->
    <line x1="34" y1="22" x2="60" y2="48" stroke="#c084fc" stroke-width="5" stroke-linecap="round"/>
    <line x1="60" y1="22" x2="34" y2="48" stroke="#c084fc" stroke-width="5" stroke-linecap="round"/>
    <!-- O at top-middle (100, 35) -->
    <circle cx="100" cy="35" r="15" fill="none" stroke="#f472b6" stroke-width="5"/>
    <!-- X at middle-center (100, 80) -->
    <line x1="87" y1="67" x2="113" y2="93" stroke="#c084fc" stroke-width="5" stroke-linecap="round"/>
    <line x1="113" y1="67" x2="87" y2="93" stroke="#c084fc" stroke-width="5" stroke-linecap="round"/>
    <!-- O at middle-left (47, 80) -->
    <circle cx="47" cy="80" r="15" fill="none" stroke="#f472b6" stroke-width="5"/>
    <!-- X at bottom-right (153, 125) -->
    <line x1="140" y1="112" x2="166" y2="138" stroke="#c084fc" stroke-width="5" stroke-linecap="round"/>
    <line x1="166" y1="112" x2="140" y2="138" stroke="#c084fc" stroke-width="5" stroke-linecap="round"/>
  </svg>
)}
