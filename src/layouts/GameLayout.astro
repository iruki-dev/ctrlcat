---
import { getCollection } from "astro:content";
import "../styles/global.css";
import GameSidebar from "../components/games/Sidebar.astro";
import Icon from "../components/Icon.astro";
import type { Locale } from "../i18n";
import { t } from "../i18n";

interface Props {
  title: string;
  description: string;
  icon?: string;
  category?: string;
  difficulty?: number;
  playTime?: number;
  currentSlug?: string;
  lang?: Locale;
  showHeader?: boolean;
}

const {
  title,
  description,
  icon,
  category,
  difficulty,
  playTime,
  currentSlug,
  lang = "en",
  showHeader = true,
} = Astro.props;

const tr = t(lang);
const pageTitle = `${title} — ${tr.games.siteTitle}`;

const difficultyLabel = tr.games.difficulty[difficulty ?? 0] ?? "";
const difficultyColor = ["", "text-green-600", "text-lime-600", "text-yellow-600", "text-orange-600", "text-red-600"][difficulty ?? 0] ?? "";

const allGames = await getCollection("games", ({ data }) => data.status === "published");
allGames.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<!doctype html>
<html lang={lang} class="realm-game">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon-game.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body class="bg-game-bg text-game-text font-sans min-h-screen flex">

    <GameSidebar
      games={allGames}
      currentSlug={currentSlug}
      lang={lang}
      url={Astro.url}
    />

    <div class="flex-1 lg:ml-64 flex flex-col min-h-screen">

      <!-- Mobile top bar -->
      <header class="lg:hidden sticky top-0 z-30 h-12 flex items-center gap-3 px-4
                     border-b border-game-border-dim bg-game-bg/95 backdrop-blur-md shrink-0">
        <button
          id="sidebar-menu-btn"
          aria-label="Open navigation"
          class="w-8 h-8 flex items-center justify-center rounded-md text-game-muted
                 hover:text-game-text hover:bg-game-surface transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <rect y="2" width="16" height="1.5" rx="0.75"/>
            <rect y="7.25" width="16" height="1.5" rx="0.75"/>
            <rect y="12.5" width="16" height="1.5" rx="0.75"/>
          </svg>
        </button>
        <a href="/" class="flex items-center gap-1.5 font-bold text-sm">
          <svg width="18" height="18" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="32" height="32" rx="8" fill="#09090b"/>
            <path d="M9 18 L16 9 L23 18" stroke="#c084fc" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="16" cy="24" r="3" stroke="#c084fc" stroke-width="2.5"/>
          </svg>
          <span class="text-game-text">ctrl</span><span class="text-game-accent">cat</span>
          <span class="text-game-muted font-normal text-xs ml-1">games</span>
        </a>
        {currentSlug && (
          <div class="flex items-center gap-1.5 text-xs text-game-muted ml-1">
            <span class="opacity-40">/</span>
            <span class="text-game-text-dim truncate max-w-36">{title}</span>
          </div>
        )}
      </header>

      {showHeader && (
        <div class="border-b border-game-border-dim bg-game-bg">
          <div class="px-6 py-5 max-w-4xl">
            {category && (
              <div class="text-2xs text-game-muted uppercase tracking-widest font-medium mb-2">
                {tr.games.categories_map[category as keyof typeof tr.games.categories_map] ?? category}
              </div>
            )}
            <div class="flex items-center gap-3">
              {icon && <span class="text-game-accent shrink-0"><Icon name={icon} size={24} /></span>}
              <div class="flex-1 min-w-0">
                <h1 class="text-xl font-bold text-game-text">{title}</h1>
                <p class="text-sm text-game-text-dim mt-0.5">{description}</p>
              </div>
            </div>
            <!-- Badges -->
            {(difficulty || playTime) && (
              <div class="flex items-center gap-3 mt-3">
                {difficulty && (
                  <span class={`text-xs font-semibold uppercase tracking-wider ${difficultyColor}`}>
                    {difficultyLabel}
                  </span>
                )}
                {playTime && (
                  <span class="text-xs text-game-muted">
                    {tr.games.playTime(playTime)}
                  </span>
                )}
              </div>
            )}
          </div>
        </div>
      )}

      <main class="flex-1 px-4 md:px-6 py-6 max-w-4xl w-full">
        <slot />
      </main>

      <footer class="border-t border-game-border-dim px-6 py-5 flex flex-wrap items-center justify-between gap-3
                     text-xs text-game-muted">
        <div class="flex items-center gap-4">
          <a href="/" class="font-semibold text-game-text-dim hover:text-game-text transition-colors">
            ctrl<span class="text-game-accent">cat</span>
          </a>
          <a href="/tools/" class="hover:text-game-text transition-colors">Tools</a>
          <a href="/games/" class="hover:text-game-text transition-colors">Games</a>
        </div>
        <span>ctrlcat.dev</span>
      </footer>

    </div>
  </body>
</html>
