---
import { getCollection } from "astro:content";
import "../styles/global.css";
import GameSidebar from "../components/games/Sidebar.astro";
import Icon from "../components/Icon.astro";
import type { Locale } from "../i18n";
import { t } from "../i18n";

interface Props {
  title: string;
  description: string;
  icon?: string;
  category?: string;
  difficulty?: number;
  playTime?: number;
  currentSlug?: string;
  lang?: Locale;
  showHeader?: boolean;
}

const {
  title,
  description,
  icon,
  category,
  difficulty,
  playTime,
  currentSlug,
  lang = "en",
  showHeader = true,
} = Astro.props;

const tr = t(lang);
const pageTitle = `${title} — ${tr.games.siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const enURL = new URL(Astro.url.pathname.replace(/^\/ko\//, "/"), Astro.site);
const koURL = new URL("/ko" + Astro.url.pathname.replace(/^\/ko\//, "/"), Astro.site);

const difficultyLabel = tr.games.difficulty[difficulty ?? 0] ?? "";
const difficultyColor = ["", "text-green-600 dark:text-green-400", "text-lime-600 dark:text-lime-400", "text-yellow-600 dark:text-yellow-400", "text-orange-600 dark:text-orange-400", "text-red-600 dark:text-red-400"][difficulty ?? 0] ?? "";

const allGames = await getCollection("games", ({ data }) => data.status === "published");
allGames.sort((a, b) => a.data.title.localeCompare(b.data.title));

const jsonLd = currentSlug ? {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  "name": title,
  "description": description,
  "url": canonicalURL.href,
  "applicationCategory": "Game",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
} : {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": pageTitle,
  "description": description,
  "url": canonicalURL.href,
};
---

<!doctype html>
<html lang={lang} class="realm-game">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="ko" href={koURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={currentSlug ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="ctrlcat.dev" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon-game.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Dark mode: apply before first paint to prevent flash -->
    <script is:inline>
      (function () {
        const s = localStorage.getItem("ctrlcat-theme");
        const dark = s === "dark" || (!s && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (dark) document.documentElement.classList.add("dark");
      })();
    </script>
  </head>

  <body class="bg-game-bg text-game-text font-game min-h-screen flex">

    <GameSidebar
      games={allGames}
      currentSlug={currentSlug}
      lang={lang}
      url={Astro.url}
    />

    <div class="flex-1 lg:ml-64 flex flex-col min-h-screen">

      <!-- Mobile top bar — MD3 Top App Bar (Small) -->
      <header class="lg:hidden sticky top-0 z-30 h-14 flex items-center gap-3 px-4
                     bg-game-surface border-b border-game-border-dim shrink-0
                     shadow-md-1">
        <button
          id="sidebar-menu-btn"
          aria-label="Open navigation"
          class="w-10 h-10 flex items-center justify-center rounded-full text-game-text
                 hover:bg-game-text/[.08] transition-colors"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <rect y="3" width="24" height="2" rx="1"/>
            <rect y="11" width="24" height="2" rx="1"/>
            <rect y="19" width="24" height="2" rx="1"/>
          </svg>
        </button>
        <a href="/" class="flex items-center gap-1.5 font-bold text-sm flex-1 min-w-0">
          <svg width="18" height="18" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="32" height="32" rx="8" fill="#1c1b1f"/>
            <path d="M9 18 L16 9 L23 18" stroke="#d0bcff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="16" cy="24" r="3" stroke="#d0bcff" stroke-width="2.5"/>
          </svg>
          <span class="text-game-text font-medium">ctrl</span><span class="text-game-accent font-medium">cat</span>
          <span class="text-game-muted font-normal text-xs ml-1">games</span>
        </a>
        {currentSlug && (
          <span class="text-sm text-game-text font-medium truncate">{title}</span>
        )}
        <button
          class="theme-toggle w-10 h-10 flex items-center justify-center rounded-full
                 text-game-text hover:bg-game-text/[.08] transition-colors ml-auto"
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          <svg class="theme-icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          <svg class="theme-icon-dark hidden" width="18" height="18" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </button>
      </header>

      <!-- Page header — MD3 style with category chip + title -->
      {showHeader && (
        <div class="bg-game-bg">
          <div class="px-6 pt-8 pb-6 max-w-4xl">
            {category && (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium
                           bg-game-accent-light text-game-accent mb-4">
                {tr.games.categories_map[category as keyof typeof tr.games.categories_map] ?? category}
              </span>
            )}
            <div class="flex items-start gap-4">
              {icon && (
                <div class="w-12 h-12 rounded-2xl bg-game-accent-light flex items-center justify-center shrink-0">
                  <span class="text-game-accent"><Icon name={icon} size={24} /></span>
                </div>
              )}
              <div class="flex-1 min-w-0">
                <h1 class="text-2xl font-bold text-game-text leading-tight">{title}</h1>
                <p class="text-sm text-game-text-dim mt-1 leading-relaxed">{description}</p>
                {(difficulty || playTime) && (
                  <div class="flex items-center gap-3 mt-3">
                    {difficulty && (
                      <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${difficultyColor} bg-game-text/[.05]`}>
                        {difficultyLabel}
                      </span>
                    )}
                    {playTime && (
                      <span class="text-xs text-game-muted">
                        {tr.games.playTime(playTime)}
                      </span>
                    )}
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      )}

      <main class="flex-1 px-4 md:px-6 py-6 max-w-4xl w-full">
        <slot />
      </main>

      <footer class="border-t border-game-border-dim px-6 py-4 flex flex-wrap items-center justify-between gap-3
                     text-xs text-game-muted">
        <div class="flex items-center gap-4">
          <a href="/" class="font-semibold text-game-text-dim hover:text-game-text transition-colors">
            ctrl<span class="text-game-accent">cat</span>
          </a>
          <a href="/tools/" class="hover:text-game-text transition-colors">Tools</a>
          <a href="/games/" class="hover:text-game-text transition-colors">Games</a>
        </div>
        <span>ctrlcat.dev</span>
      </footer>

    </div>
  </body>

  <script is:inline>
    (function () {
      function syncIcons() {
        var dark = document.documentElement.classList.contains("dark");
        document.querySelectorAll(".theme-icon-light").forEach(function (el) {
          el.classList.toggle("hidden", dark);
        });
        document.querySelectorAll(".theme-icon-dark").forEach(function (el) {
          el.classList.toggle("hidden", !dark);
        });
      }
      syncIcons();
      document.querySelectorAll(".theme-toggle").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var dark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("ctrlcat-theme", dark ? "dark" : "light");
          syncIcons();
        });
      });
    })();
  </script>
</html>
