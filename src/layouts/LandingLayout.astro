---
import "../styles/global.css";
import type { Locale } from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const title = lang === "ko"
  ? "ctrlcat — 무료 웹 툴 & 게임"
  : "ctrlcat — Free Web Tools & Games";
const description = lang === "ko"
  ? "계정 불필요. 텍스트, 수학, 색상, 퍼즐, 숫자 게임 등 다양한 무료 웹 툴과 게임."
  : "No accounts, no tracking. Free web tools and games — text, math, color, puzzles, number games and more.";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-white text-slate-900 font-sans min-h-screen">
    <slot />
  </body>
</html>
