---
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import { t, type Locale } from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const { title, description } = t(lang).meta;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ctrlcat.dev",
  description,
  url: "https://ctrlcat.dev/",
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: "https://ctrlcat.dev/tools/?q={search_term_string}" },
    "query-input": "required name=search_term_string",
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead title={title} description={description} lang={lang} favicon="/favicon.svg" jsonLd={jsonLd} />
  </head>
  <body class="bg-site-bg text-site-text font-sans min-h-screen">
    <slot />
  </body>
</html>
