---
import { getCollection } from "astro:content";
import "../styles/global.css";
import ToolSidebar from "../components/tools/Sidebar.astro";
import Icon from "../components/Icon.astro";
import type { Locale } from "../i18n";
import { t } from "../i18n";

interface Props {
  title: string;
  description: string;
  icon?: string;
  category?: string;
  currentSlug?: string;
  lang?: Locale;
  showHeader?: boolean;
}

const {
  title,
  description,
  icon,
  category,
  currentSlug,
  lang = "en",
  showHeader = true,
} = Astro.props;

const tr = t(lang);
const pageTitle = `${title} — ${tr.tools.siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const enURL = new URL(Astro.url.pathname.replace(/^\/ko\//, "/"), Astro.site);
const koURL = new URL("/ko" + Astro.url.pathname.replace(/^\/ko\//, "/"), Astro.site);

const allTools = await getCollection("tools", ({ data }) => data.status === "published");
allTools.sort((a, b) => a.data.title.localeCompare(b.data.title));

const jsonLd = currentSlug ? {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": title,
  "description": description,
  "url": canonicalURL.href,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
} : {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": pageTitle,
  "description": description,
  "url": canonicalURL.href,
};
---

<!doctype html>
<html lang={lang} class="realm-tool">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="ko" href={koURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={currentSlug ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="ctrlcat.dev" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon-tool.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Dark mode: apply before first paint to prevent flash -->
    <script is:inline>
      (function () {
        var s = localStorage.getItem("ctrlcat-theme");
        var dark = s === "dark" || (!s && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (dark) document.documentElement.classList.add("dark");
      })();
    </script>
  </head>

  <body class="bg-tool-bg text-tool-text font-tool min-h-screen flex">

    <ToolSidebar
      tools={allTools}
      currentSlug={currentSlug}
      lang={lang}
      url={Astro.url}
    />

    <div class="flex-1 lg:ml-64 flex flex-col min-h-screen">

      <!-- Mobile top bar — Carbon shell header style -->
      <header class="lg:hidden sticky top-0 z-30 h-12 flex items-center gap-3 px-4
                     border-b border-tool-border bg-tool-surface shrink-0">
        <button
          id="sidebar-menu-btn"
          aria-label="Open navigation"
          class="w-8 h-8 flex items-center justify-center text-tool-muted
                 hover:text-tool-text hover:bg-tool-surface-2 transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <rect y="2" width="16" height="1.5" rx="0"/>
            <rect y="7.25" width="16" height="1.5" rx="0"/>
            <rect y="12.5" width="16" height="1.5" rx="0"/>
          </svg>
        </button>
        <a href="/" class="flex items-center gap-1.5 font-bold text-sm">
          <svg width="18" height="18" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="32" height="32" rx="0" fill="#161616"/>
            <path d="M9 18 L16 9 L23 18" stroke="#78a9ff" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"/>
            <line x1="10" y1="24" x2="22" y2="24" stroke="#78a9ff" stroke-width="2.5" stroke-linecap="square"/>
          </svg>
          <span class="text-tool-text">ctrl</span><span class="text-tool-accent">cat</span>
          <span class="text-tool-muted font-normal text-xs ml-1">tools</span>
        </a>
        {currentSlug && (
          <div class="flex items-center gap-1.5 text-xs text-tool-muted ml-1">
            <span class="opacity-40">/</span>
            <span class="text-tool-text-dim truncate max-w-36">{title}</span>
          </div>
        )}
        <button
          class="theme-toggle ml-auto w-8 h-8 flex items-center justify-center
                 text-tool-muted hover:text-tool-text hover:bg-tool-surface-2 transition-colors"
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          <svg class="theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          <svg class="theme-icon-dark hidden" width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </button>
      </header>

      <!-- Page header — Carbon page header pattern -->
      {showHeader && (
        <div class="border-b border-tool-border bg-tool-surface">
          <div class="px-6 py-6 max-w-4xl">
            {category && (
              <p class="text-xs text-tool-muted uppercase tracking-widest font-medium mb-2">
                {tr.tools.categories_map[category as keyof typeof tr.tools.categories_map] ?? category}
              </p>
            )}
            <div class="flex items-start gap-4">
              {icon && (
                <span class="text-tool-accent shrink-0 mt-0.5">
                  <Icon name={icon} size={24} />
                </span>
              )}
              <div>
                <h1 class="text-2xl font-semibold text-tool-text leading-tight">{title}</h1>
                <p class="text-sm text-tool-text-dim mt-1 leading-relaxed">{description}</p>
              </div>
            </div>
          </div>
        </div>
      )}

      <main class="flex-1 px-4 md:px-6 py-6 max-w-4xl w-full">
        <slot />
      </main>

      <footer class="border-t border-tool-border bg-tool-surface px-6 py-4 flex flex-wrap items-center justify-between gap-3
                     text-xs text-tool-muted">
        <div class="flex items-center gap-4">
          <a href="/" class="font-semibold text-tool-text-dim hover:text-tool-text transition-colors">
            ctrl<span class="text-tool-accent">cat</span>
          </a>
          <a href="/tools/" class="hover:text-tool-text transition-colors">Tools</a>
          <a href="/games/" class="hover:text-tool-text transition-colors">Games</a>
        </div>
        <span>ctrlcat.dev</span>
      </footer>

    </div>
  </body>

  <script is:inline>
    (function () {
      function syncIcons() {
        var dark = document.documentElement.classList.contains("dark");
        document.querySelectorAll(".theme-icon-light").forEach(function (el) {
          el.classList.toggle("hidden", dark);
        });
        document.querySelectorAll(".theme-icon-dark").forEach(function (el) {
          el.classList.toggle("hidden", !dark);
        });
      }
      syncIcons();
      document.querySelectorAll(".theme-toggle").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var dark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("ctrlcat-theme", dark ? "dark" : "light");
          syncIcons();
        });
      });
    })();
  </script>
</html>
