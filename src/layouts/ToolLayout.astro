---
import { getCollection } from "astro:content";
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";
import ThemeToggleScript from "../components/ThemeToggleScript.astro";
import ToolSidebar from "../components/tools/Sidebar.astro";
import Icon from "../components/Icon.astro";
import { t, localePath, type Locale } from "../i18n";

interface Props {
  title: string;
  description: string;
  icon?: string;
  category?: string;
  currentSlug?: string;
  lang?: Locale;
  showHeader?: boolean;
}

const { title, description, icon, category, currentSlug, lang = "en", showHeader = true } = Astro.props;

const tr = t(lang);
const pageTitle = `${title} — ${tr.tools.siteTitle}`;
const pageURL = new URL(Astro.url.pathname, Astro.site).href;

const allTools = await getCollection("tools", ({ data }) => data.status === "published");
allTools.sort((a, b) => a.data.title.localeCompare(b.data.title));

const jsonLd = currentSlug
  ? {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: title,
      description,
      url: pageURL,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Web",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    }
  : { "@context": "https://schema.org", "@type": "CollectionPage", name: pageTitle, description, url: pageURL };
---

<!doctype html>
<html lang={lang} class="realm-tool">
  <head>
    <SeoHead
      title={pageTitle}
      description={description}
      lang={lang}
      favicon="/favicon-tool.svg"
      ogType={currentSlug ? "article" : "website"}
      jsonLd={jsonLd}
    />
  </head>

  <body class="bg-tool-bg text-tool-text font-tool min-h-screen flex">
    <ToolSidebar tools={allTools} currentSlug={currentSlug} lang={lang} url={Astro.url} />

    <div class="flex-1 min-w-0 lg:ml-64 flex flex-col min-h-screen">
      <!-- Mobile top bar -->
      <header class="lg:hidden sticky top-0 z-30 h-12 flex items-center gap-3 px-4
                     border-b border-tool-border bg-tool-surface shrink-0">
        <button
          id="sidebar-menu-btn"
          aria-label={tr.nav.openMenu}
          class="w-8 h-8 flex items-center justify-center text-tool-muted
                 hover:text-tool-text hover:bg-tool-surface-2 transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <rect y="2" width="16" height="1.5" />
            <rect y="7.25" width="16" height="1.5" />
            <rect y="12.5" width="16" height="1.5" />
          </svg>
        </button>
        <a href={localePath("/", lang)} class="flex items-center gap-1.5 font-bold text-sm">
          <svg width="18" height="18" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="32" height="32" rx="0" fill="#161616"/>
            <path d="M9 18 L16 9 L23 18" stroke="#78a9ff" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"/>
            <line x1="10" y1="24" x2="22" y2="24" stroke="#78a9ff" stroke-width="2.5" stroke-linecap="square"/>
          </svg>
          <span class="text-tool-text">ctrl</span><span class="text-tool-accent">cat</span>
          <span class="text-tool-muted font-normal text-xs ml-1">tools</span>
        </a>
        {currentSlug && (
          <div class="flex items-center gap-1.5 text-xs text-tool-muted ml-1">
            <span class="opacity-40">/</span>
            <span class="text-tool-text-dim truncate max-w-36">{title}</span>
          </div>
        )}
        <button
          class="theme-toggle ml-auto w-8 h-8 flex items-center justify-center
                 text-tool-muted hover:text-tool-text hover:bg-tool-surface-2 transition-colors"
          aria-label={tr.nav.toggleTheme}
          title={tr.nav.toggleTheme}
        >
          <svg class="theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          <svg class="theme-icon-dark hidden" width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </button>
      </header>

      {showHeader && (
        <div class="border-b border-tool-border bg-tool-surface">
          <div class="px-6 py-6 max-w-4xl">
            {category && (
              <p class="text-xs text-tool-muted uppercase tracking-widest font-medium mb-2">
                {tr.tools.categories_map[category as keyof typeof tr.tools.categories_map] ?? category}
              </p>
            )}
            <div class="flex items-start gap-4">
              {icon && (
                <span class="text-tool-accent shrink-0 mt-0.5">
                  <Icon name={icon} size={24} />
                </span>
              )}
              <div>
                <h1 class="text-2xl font-semibold text-tool-text leading-tight">{title}</h1>
                <p class="text-sm text-tool-text-dim mt-1 leading-relaxed">{description}</p>
              </div>
            </div>
          </div>
        </div>
      )}

      <main class="flex-1 px-4 md:px-6 py-6 max-w-4xl w-full">
        <slot />
      </main>

      <footer class="border-t border-tool-border bg-tool-surface px-6 py-4 flex flex-wrap items-center justify-between gap-3
                     text-xs text-tool-muted">
        <div class="flex items-center gap-4">
          <a href={localePath("/", lang)} class="font-semibold text-tool-text-dim hover:text-tool-text transition-colors">
            ctrl<span class="text-tool-accent">cat</span>
          </a>
          <a href={localePath("/tools/", lang)} class="hover:text-tool-text transition-colors">{tr.nav.tools}</a>
          <a href={localePath("/games/", lang)} class="hover:text-tool-text transition-colors">{tr.nav.games}</a>
        </div>
        <span>ctrlcat.dev</span>
      </footer>
    </div>
    <ThemeToggleScript />
  </body>
</html>
