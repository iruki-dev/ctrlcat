---
import { getCollection } from "astro:content";
import "../styles/global.css";
import ToolSidebar from "../components/tools/Sidebar.astro";
import Icon from "../components/Icon.astro";
import type { Locale } from "../i18n";
import { t } from "../i18n";

interface Props {
  title: string;
  description: string;
  icon?: string;
  category?: string;
  currentSlug?: string;
  lang?: Locale;
  /** Set false on listing pages to suppress the page header */
  showHeader?: boolean;
}

const {
  title,
  description,
  icon,
  category,
  currentSlug,
  lang = "en",
  showHeader = true,
} = Astro.props;

const tr = t(lang);
const pageTitle = `${title} — ${tr.tools.siteTitle}`;

const allTools = await getCollection("tools", ({ data }) => data.status === "published");
allTools.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<!doctype html>
<html lang={lang} class="realm-tool">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon-tool.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body class="bg-tool-bg text-tool-text font-sans min-h-screen flex">

    <!-- Sidebar -->
    <ToolSidebar
      tools={allTools}
      currentSlug={currentSlug}
      lang={lang}
      url={Astro.url}
    />

    <!-- Main area (offset for sidebar on lg) -->
    <div class="flex-1 lg:ml-64 flex flex-col min-h-screen">

      <!-- Mobile top bar -->
      <header class="lg:hidden sticky top-0 z-30 h-12 flex items-center gap-3 px-4
                     border-b border-tool-border-dim bg-tool-bg/95 backdrop-blur-md shrink-0">
        <button
          id="sidebar-menu-btn"
          aria-label="Open navigation"
          class="w-8 h-8 flex items-center justify-center rounded-md text-tool-muted
                 hover:text-tool-text hover:bg-tool-surface transition-colors"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <rect y="2" width="16" height="1.5" rx="0.75"/>
            <rect y="7.25" width="16" height="1.5" rx="0.75"/>
            <rect y="12.5" width="16" height="1.5" rx="0.75"/>
          </svg>
        </button>
        <a href="/" class="flex items-center gap-1.5 font-bold text-sm">
          <svg width="18" height="18" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="32" height="32" rx="8" fill="#09090b"/>
            <path d="M9 18 L16 9 L23 18" stroke="#00d4aa" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <line x1="10" y1="24" x2="22" y2="24" stroke="#00d4aa" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
          <span class="text-tool-text">ctrl</span><span class="text-tool-accent">cat</span>
          <span class="text-tool-muted font-normal text-xs ml-1">tools</span>
        </a>
        {currentSlug && (
          <div class="flex items-center gap-1.5 text-xs text-tool-muted ml-1">
            <span class="opacity-40">/</span>
            <span class="text-tool-text-dim truncate max-w-36">{title}</span>
          </div>
        )}
      </header>

      <!-- Page header (desktop breadcrumb + title) -->
      {showHeader && (
        <div class="border-b border-tool-border-dim bg-tool-bg">
          <div class="px-6 py-5 max-w-4xl">
            {category && (
              <div class="text-2xs text-tool-muted uppercase tracking-widest font-medium mb-2">
                {tr.tools.categories_map[category as keyof typeof tr.tools.categories_map] ?? category}
              </div>
            )}
            <div class="flex items-center gap-3">
              {icon && <span class="text-tool-accent shrink-0"><Icon name={icon} size={24} /></span>}
              <div>
                <h1 class="text-xl font-bold text-tool-text">{title}</h1>
                <p class="text-sm text-tool-text-dim mt-0.5">{description}</p>
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- Content -->
      <main class="flex-1 px-4 md:px-6 py-6 max-w-4xl w-full">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="border-t border-tool-border-dim px-6 py-5 flex flex-wrap items-center justify-between gap-3
                     text-xs text-tool-muted">
        <div class="flex items-center gap-4">
          <a href="/" class="font-semibold text-tool-text-dim hover:text-tool-text transition-colors">
            ctrl<span class="text-tool-accent">cat</span>
          </a>
          <a href="/tools/" class="hover:text-tool-text transition-colors">Tools</a>
          <a href="/games/" class="hover:text-tool-text transition-colors">Games</a>
        </div>
        <span>ctrlcat.dev</span>
      </footer>

    </div>
  </body>
</html>
