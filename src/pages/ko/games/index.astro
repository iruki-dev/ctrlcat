---
import { getCollection } from "astro:content";
import GameLayout from "../../../layouts/GameLayout.astro";
import GameIllustration from "../../../components/GameIllustration.astro";
import { t } from "../../../i18n";

const lang = "ko";
const tr = t(lang);

const allGames = await getCollection("games", ({ data }) => data.status === "published");
allGames.sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0) || a.data.title.localeCompare(b.data.title));

const categories = [...new Set(allGames.map(g => g.data.category))].sort();

function getTitle(game: typeof allGames[number]) {
  return game.data.localizations?.[lang]?.title ?? game.data.title;
}
---

<GameLayout
  title={tr.games.pageTitle}
  description={tr.games.pageSubtitle}
  lang={lang}
  showHeader={false}
>
  <!-- MD3 page heading -->
  <div class="mb-8">
    <h1 class="text-[1.75rem] font-bold text-game-text leading-snug">{tr.games.pageTitle}</h1>
    <p class="text-sm text-game-text-dim mt-1.5 leading-relaxed">{tr.games.pageSubtitle}</p>
  </div>

  <!-- MD3 search field -->
  <div class="relative max-w-sm mb-5">
    <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-game-muted w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
    </svg>
    <input
      id="game-search"
      type="search"
      placeholder={tr.games.search}
      class="w-full bg-game-surface border border-game-border rounded-full pl-11 pr-4 py-2.5
             text-game-text text-sm placeholder:text-game-muted
             focus:outline-none focus:ring-2 focus:ring-game-accent focus:border-game-accent transition-colors"
    />
  </div>

  <!-- MD3 Filter Chips -->
  <div class="flex gap-2 flex-wrap mb-6">
    <button
      data-filter="all"
      class="filter-chip px-4 py-2 rounded-full text-xs font-medium border-2 border-game-accent bg-game-accent-light text-game-accent transition-colors"
    >
      {tr.games.all}
    </button>
    {categories.map(cat => (
      <button
        data-filter={cat}
        class="filter-chip px-4 py-2 rounded-full text-xs font-medium border border-game-border-dim bg-game-surface text-game-text-dim
               hover:bg-game-surface-2 hover:border-game-border transition-colors capitalize"
      >
        {tr.games.categories_map[cat as keyof typeof tr.games.categories_map] ?? cat}
      </button>
    ))}
  </div>

  <!-- MD3 Card grid -->
  <div id="game-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {allGames.map(game => {
      const diffColor = ["", "text-green-600 dark:text-green-400", "text-lime-600 dark:text-lime-400", "text-yellow-600 dark:text-yellow-400", "text-orange-600 dark:text-orange-400", "text-red-600 dark:text-red-400"][game.data.difficulty ?? 0] ?? "";
      return (
        <a
          href={`/ko/games/${game.slug}/`}
          data-category={game.data.category}
          data-title={getTitle(game).toLowerCase()}
          data-tags={game.data.tags.join(" ").toLowerCase()}
          class="game-card group block rounded-3xl overflow-hidden
                 bg-game-surface shadow-md-1
                 hover:shadow-md-3 transition-shadow duration-200 focus:outline-none
                 focus:ring-2 focus:ring-game-accent focus:ring-offset-2"
        >
          <div class="flex items-center justify-center bg-game-accent-light/30 h-44">
            <GameIllustration slug={game.slug} />
          </div>
          <div class="px-5 py-4">
            <h2 class="font-bold text-sm text-game-text group-hover:text-game-accent transition-colors leading-snug">
              {getTitle(game)}
            </h2>
            <div class="flex items-center gap-3 mt-2">
              {game.data.difficulty && (
                <span class={`text-xs font-semibold px-2 py-0.5 rounded-full bg-game-surface-2 ${diffColor}`}>
                  {tr.games.difficulty[game.data.difficulty]}
                </span>
              )}
              {game.data.playTime && (
                <span class="text-xs text-game-muted">{tr.games.playTime(game.data.playTime)}</span>
              )}
              <span class="text-xs font-semibold text-game-accent group-hover:underline ml-auto shrink-0">
                {tr.landing.playGame}
              </span>
            </div>
          </div>
        </a>
      );
    })}
  </div>

  <div id="game-empty" class="hidden py-20 text-center text-sm text-game-muted">{tr.games.noResults}</div>
</GameLayout>

<script>
  const search = document.getElementById("game-search") as HTMLInputElement;
  const empty = document.getElementById("game-empty")!;
  const grid = document.getElementById("game-grid")!;
  const filterChips = document.querySelectorAll<HTMLButtonElement>(".filter-chip");
  const cards = document.querySelectorAll<HTMLElement>(".game-card");
  let activeCategory = "all";

  function update() {
    let visible = 0;
    const q = search.value.toLowerCase().trim();
    cards.forEach((card) => {
      const ok = (activeCategory === "all" || card.dataset.category === activeCategory) && (!q || card.dataset.title!.includes(q) || card.dataset.tags!.includes(q));
      card.style.display = ok ? "" : "none";
      if (ok) visible++;
    });
    empty.classList.toggle("hidden", visible > 0);
    grid.classList.toggle("hidden", visible === 0);
  }

  search.addEventListener("input", update);

  filterChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      filterChips.forEach((c) => {
        c.classList.remove("border-2", "border-game-accent", "bg-game-accent-light", "text-game-accent");
        c.classList.add("border", "border-game-border-dim", "bg-game-surface", "text-game-text-dim");
      });
      chip.classList.add("border-2", "border-game-accent", "bg-game-accent-light", "text-game-accent");
      chip.classList.remove("border", "border-game-border-dim", "bg-game-surface", "text-game-text-dim");
      activeCategory = chip.dataset.filter!;
      update();
    });
  });
</script>
