---
import { getCollection } from "astro:content";
import GameLayout from "../../../layouts/GameLayout.astro";
import GameIllustration from "../../../components/GameIllustration.astro";
import { t } from "../../../i18n";

const lang = "ko";
const tr = t(lang);

const allGames = await getCollection("games", ({ data }) => data.status === "published");
allGames.sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0) || a.data.title.localeCompare(b.data.title));

const categories = [...new Set(allGames.map(g => g.data.category))].sort();

function getTitle(game: typeof allGames[number]) {
  return game.data.localizations?.[lang]?.title ?? game.data.title;
}
---

<GameLayout
  title={tr.games.pageTitle}
  description={tr.games.pageSubtitle}
  lang={lang}
  showHeader={false}
>
  <div class="mb-6">
    <h1 class="text-lg font-bold text-game-text">{tr.games.pageTitle}</h1>
    <p class="text-sm text-game-text-dim mt-0.5">{tr.games.pageSubtitle}</p>
  </div>

  <div class="flex flex-col sm:flex-row gap-3 mb-6">
    <div class="relative flex-1 max-w-xs">
      <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-game-muted text-xs">⌕</span>
      <input
        id="game-search"
        type="search"
        placeholder={tr.games.search}
        class="w-full bg-game-surface border border-game-border rounded-md pl-7 pr-3 py-1.5
               text-game-text text-sm placeholder:text-game-muted
               focus:outline-none focus:ring-1 focus:ring-game-accent focus:border-game-accent transition-colors"
      />
    </div>
    <div class="flex gap-1.5 flex-wrap">
      <button data-filter="all" class="filter-btn px-2.5 py-1 text-xs rounded-md border border-game-accent text-game-accent bg-game-accent/10 font-medium">
        {tr.games.all}
      </button>
      {categories.map(cat => (
        <button data-filter={cat} class="filter-btn px-2.5 py-1 text-xs rounded-md border border-game-border text-game-muted hover:border-game-accent hover:text-game-accent font-medium transition-colors">
          {tr.games.categories_map[cat as keyof typeof tr.games.categories_map] ?? cat}
        </button>
      ))}
    </div>
  </div>

  <div id="game-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {allGames.map(game => {
      const diffColor = ["","text-green-600","text-lime-600","text-yellow-600","text-orange-600","text-red-600"][game.data.difficulty ?? 0] ?? "";
      return (
        <a
          href={`/ko/games/${game.slug}/`}
          data-category={game.data.category}
          data-title={getTitle(game).toLowerCase()}
          data-tags={game.data.tags.join(" ").toLowerCase()}
          class="game-card group block rounded-2xl overflow-hidden border-2 border-game-border bg-game-surface
                 hover:border-game-accent hover:shadow-xl transition-all duration-200"
        >
          <!-- Illustration -->
          <div class="flex items-center justify-center bg-white h-44">
            <GameIllustration slug={game.slug} />
          </div>
          <!-- Text -->
          <div class="px-4 py-3 border-t border-game-border">
            <div class="font-bold text-sm text-game-text group-hover:text-game-accent transition-colors">
              {getTitle(game)}
            </div>
            <div class="flex items-center justify-between mt-1.5">
              <div class="flex items-center gap-2 text-xs text-game-muted">
                {game.data.difficulty && (
                  <span class={`font-medium ${diffColor}`}>{tr.games.difficulty[game.data.difficulty]}</span>
                )}
                {game.data.playTime && (
                  <span>{tr.games.playTime(game.data.playTime)}</span>
                )}
              </div>
              <span class="text-xs font-semibold text-game-accent group-hover:underline shrink-0">
                {tr.landing.playGame}
              </span>
            </div>
          </div>
        </a>
      );
    })}
  </div>

  <div id="game-empty" class="hidden py-20 text-center text-sm text-game-muted">{tr.games.noResults}</div>
</GameLayout>

<script>
  const search = document.getElementById("game-search") as HTMLInputElement;
  const empty = document.getElementById("game-empty")!;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".game-card");
  let activeCategory = "all";
  function update() {
    let visible = 0;
    const q = search.value.toLowerCase().trim();
    cards.forEach((card) => {
      const ok = (activeCategory === "all" || card.dataset.category === activeCategory) && (!q || card.dataset.title!.includes(q) || card.dataset.tags!.includes(q));
      card.style.display = ok ? "" : "none";
      if (ok) visible++;
    });
    empty.classList.toggle("hidden", visible > 0);
  }
  search.addEventListener("input", update);
  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach(b => { b.classList.remove("border-game-accent","text-game-accent","bg-game-accent/10"); b.classList.add("border-game-border","text-game-muted"); });
      btn.classList.add("border-game-accent","text-game-accent","bg-game-accent/10");
      btn.classList.remove("border-game-border","text-game-muted");
      activeCategory = btn.dataset.filter!;
      update();
    });
  });
</script>
