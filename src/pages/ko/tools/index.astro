---
import { getCollection } from "astro:content";
import ToolLayout from "../../../layouts/ToolLayout.astro";
import Icon from "../../../components/Icon.astro";
import { t } from "../../../i18n";

const lang = "ko";
const tr = t(lang);

const allTools = await getCollection("tools", ({ data }) => data.status === "published");
allTools.sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0) || a.data.title.localeCompare(b.data.title));

const categories = [...new Set(allTools.map(t => t.data.category))].sort();

function getTitle(tool: typeof allTools[number]) {
  return tool.data.localizations?.[lang]?.title ?? tool.data.title;
}
function getDesc(tool: typeof allTools[number]) {
  return tool.data.localizations?.[lang]?.description ?? tool.data.description;
}
---

<ToolLayout
  title={tr.tools.pageTitle}
  description={tr.tools.pageSubtitle}
  lang={lang}
  showHeader={false}
>
  <div class="mb-6">
    <h1 class="text-lg font-bold text-tool-text">{tr.tools.pageTitle}</h1>
    <p class="text-sm text-tool-text-dim mt-0.5">{tr.tools.pageSubtitle}</p>
  </div>

  <div class="flex flex-col sm:flex-row gap-3 mb-6">
    <div class="relative flex-1 max-w-xs">
      <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-tool-muted text-xs">⌕</span>
      <input
        id="tool-search"
        type="search"
        placeholder={tr.tools.search}
        class="w-full bg-tool-surface border border-tool-border rounded-md pl-7 pr-3 py-1.5
               text-tool-text text-sm placeholder:text-tool-muted
               focus:outline-none focus:ring-1 focus:ring-tool-accent focus:border-tool-accent transition-colors"
      />
    </div>
    <div class="flex gap-1.5 flex-wrap">
      <button data-filter="all" class="filter-btn px-2.5 py-1 text-xs rounded-md border border-tool-accent text-tool-accent bg-tool-accent/10 font-medium">
        {tr.tools.all}
      </button>
      {categories.map(cat => (
        <button data-filter={cat} class="filter-btn px-2.5 py-1 text-xs rounded-md border border-tool-border text-tool-muted hover:border-tool-accent hover:text-tool-accent font-medium transition-colors">
          {tr.tools.categories_map[cat as keyof typeof tr.tools.categories_map] ?? cat}
        </button>
      ))}
    </div>
  </div>

  <div id="tool-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3">
    {allTools.map(tool => (
      <a
        href={`/ko/tools/${tool.slug}/`}
        data-category={tool.data.category}
        data-title={getTitle(tool).toLowerCase()}
        data-tags={tool.data.tags.join(" ").toLowerCase()}
        class="tool-card group flex flex-col gap-3 rounded-xl border border-tool-border border-t-2 border-t-tool-accent bg-tool-surface p-4 hover:shadow-md transition-all duration-150"
      >
        <div class="flex items-start justify-between gap-2">
          <span class="text-tool-accent"><Icon name={tool.data.icon ?? ""} size={22} /></span>
          {tool.data.featured && (
            <span class="shrink-0 text-2xs px-1.5 py-0.5 rounded border border-tool-accent/30 text-tool-accent bg-tool-accent/5 font-medium uppercase tracking-wide">
              {tr.tools.featured}
            </span>
          )}
        </div>
        <div class="flex-1">
          <div class="font-semibold text-sm text-tool-text group-hover:text-tool-accent transition-colors">
            {getTitle(tool)}
          </div>
          <div class="text-xs text-tool-text-dim mt-1 line-clamp-2 leading-relaxed">
            {getDesc(tool)}
          </div>
        </div>
        <div class="mt-auto pt-3 flex items-center justify-between">
          <div class="flex flex-wrap gap-1">
            {tool.data.tags.slice(0, 2).map(tag => (
              <span class="text-2xs px-1.5 py-0.5 rounded bg-tool-surface-2 text-tool-muted border border-tool-border-dim">{tag}</span>
            ))}
          </div>
          <span class="text-xs font-semibold text-tool-accent group-hover:underline shrink-0">
            {tr.landing.useTool}
          </span>
        </div>
      </a>
    ))}
  </div>
  <div id="tool-empty" class="hidden py-20 text-center text-sm text-tool-muted">{tr.tools.noResults}</div>
</ToolLayout>

<script>
  const search = document.getElementById("tool-search") as HTMLInputElement;
  const empty = document.getElementById("tool-empty")!;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".tool-card");
  let activeCategory = "all";
  function update() {
    let visible = 0;
    const q = search.value.toLowerCase().trim();
    cards.forEach((card) => {
      const ok = (activeCategory === "all" || card.dataset.category === activeCategory) && (!q || card.dataset.title!.includes(q) || card.dataset.tags!.includes(q));
      card.style.display = ok ? "" : "none";
      if (ok) visible++;
    });
    empty.classList.toggle("hidden", visible > 0);
  }
  search.addEventListener("input", update);
  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach(b => { b.classList.remove("border-tool-accent","text-tool-accent","bg-tool-accent/10"); b.classList.add("border-tool-border","text-tool-muted"); });
      btn.classList.add("border-tool-accent","text-tool-accent","bg-tool-accent/10");
      btn.classList.remove("border-tool-border","text-tool-muted");
      activeCategory = btn.dataset.filter!;
      update();
    });
  });
</script>
