---
import { getCollection } from "astro:content";
import ToolLayout from "../../../layouts/ToolLayout.astro";
import Icon from "../../../components/Icon.astro";
import { t } from "../../../i18n";

const lang = "ko";
const tr = t(lang);

const allTools = await getCollection("tools", ({ data }) => data.status === "published");
allTools.sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0) || a.data.title.localeCompare(b.data.title));

const categories = [...new Set(allTools.map(t => t.data.category))].sort();

function getTitle(tool: typeof allTools[number]) {
  return tool.data.localizations?.[lang]?.title ?? tool.data.title;
}
function getDesc(tool: typeof allTools[number]) {
  return tool.data.localizations?.[lang]?.description ?? tool.data.description;
}
---

<ToolLayout
  title={tr.tools.pageTitle}
  description={tr.tools.pageSubtitle}
  lang={lang}
  showHeader={false}
>
  <!-- Carbon page heading -->
  <div class="mb-8 border-b border-tool-border pb-6">
    <h1 class="text-2xl font-semibold text-tool-text">{tr.tools.pageTitle}</h1>
    <p class="text-sm text-tool-text-dim mt-1">{tr.tools.pageSubtitle}</p>
  </div>

  <!-- Carbon filter bar -->
  <div class="flex flex-col sm:flex-row gap-4 mb-6">
    <div class="relative flex-1 max-w-sm">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-tool-muted w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input
        id="tool-search"
        type="search"
        placeholder={tr.tools.search}
        class="w-full bg-tool-surface border border-tool-border text-tool-text text-sm pl-9 pr-3 py-2
               placeholder:text-tool-muted focus:outline-none focus:ring-2 focus:ring-tool-accent focus:border-tool-accent
               transition-colors"
      />
    </div>
    <div class="flex gap-0 flex-wrap border border-tool-border divide-x divide-tool-border overflow-hidden">
      <button
        data-filter="all"
        class="filter-btn px-3 py-2 text-xs font-medium bg-tool-accent text-white transition-colors whitespace-nowrap"
      >
        {tr.tools.all}
      </button>
      {categories.map(cat => (
        <button
          data-filter={cat}
          class="filter-btn px-3 py-2 text-xs font-medium text-tool-text-dim bg-tool-surface
                 hover:bg-tool-surface-2 hover:text-tool-text transition-colors whitespace-nowrap capitalize"
        >
          {tr.tools.categories_map[cat as keyof typeof tr.tools.categories_map] ?? cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Carbon tile grid -->
  <div id="tool-grid"
       class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-px bg-tool-border border border-tool-border">
    {allTools.map(tool => (
      <a
        href={`/ko/tools/${tool.slug}/`}
        data-category={tool.data.category}
        data-title={getTitle(tool).toLowerCase()}
        data-tags={tool.data.tags.join(" ").toLowerCase()}
        class="tool-card group flex flex-col gap-3 bg-tool-surface p-5
               hover:bg-tool-accent-light transition-colors duration-150 focus:outline-none
               focus:ring-2 focus:ring-inset focus:ring-tool-accent"
      >
        <div class="flex items-start justify-between gap-2">
          <span class="text-tool-accent"><Icon name={tool.data.icon ?? ""} size={20} /></span>
          {tool.data.featured && (
            <span class="shrink-0 text-2xs px-1.5 py-0.5 border border-tool-accent/40 text-tool-accent bg-tool-accent/5 font-medium uppercase tracking-wide">
              {tr.tools.featured}
            </span>
          )}
        </div>
        <div class="flex-1">
          <div class="font-semibold text-sm text-tool-text group-hover:text-tool-accent transition-colors leading-snug">
            {getTitle(tool)}
          </div>
          <div class="text-xs text-tool-text-dim mt-1.5 line-clamp-2 leading-relaxed">
            {getDesc(tool)}
          </div>
        </div>
        <div class="flex items-center justify-between pt-2 border-t border-tool-border-dim">
          <div class="flex flex-wrap gap-1">
            {tool.data.tags.slice(0, 2).map(tag => (
              <span class="text-2xs px-1.5 py-0.5 bg-tool-surface-2 text-tool-muted">{tag}</span>
            ))}
          </div>
          <span class="text-xs font-medium text-tool-accent group-hover:underline shrink-0">
            {tr.landing.useTool}
          </span>
        </div>
      </a>
    ))}
  </div>

  <div id="tool-empty" class="hidden py-20 text-center text-sm text-tool-muted">{tr.tools.noResults}</div>
</ToolLayout>

<script>
  const search = document.getElementById("tool-search") as HTMLInputElement;
  const grid = document.getElementById("tool-grid")!;
  const empty = document.getElementById("tool-empty")!;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".tool-card");
  let activeCategory = "all";

  function update() {
    let visible = 0;
    const q = search.value.toLowerCase().trim();
    cards.forEach((card) => {
      const ok = (activeCategory === "all" || card.dataset.category === activeCategory) && (!q || card.dataset.title!.includes(q) || card.dataset.tags!.includes(q));
      card.style.display = ok ? "" : "none";
      if (ok) visible++;
    });
    empty.classList.toggle("hidden", visible > 0);
    grid.classList.toggle("hidden", visible === 0);
  }

  search.addEventListener("input", update);

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach(b => {
        b.classList.remove("bg-tool-accent", "text-white");
        b.classList.add("bg-tool-surface", "text-tool-text-dim");
      });
      btn.classList.add("bg-tool-accent", "text-white");
      btn.classList.remove("bg-tool-surface", "text-tool-text-dim");
      activeCategory = btn.dataset.filter!;
      update();
    });
  });
</script>
