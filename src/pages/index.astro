---
import { getCollection } from "astro:content";
import LandingLayout from "../layouts/LandingLayout.astro";
import Icon from "../components/Icon.astro";
import GameIllustration from "../components/GameIllustration.astro";
import { t, localePath } from "../i18n";

const lang = "en";
const tr = t(lang);

const allTools = await getCollection("tools", ({ data }) => data.status === "published");
allTools.sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0) || a.data.title.localeCompare(b.data.title));
const featuredTools = allTools.slice(0, 8);

const allGames = await getCollection("games", ({ data }) => data.status === "published");
allGames.sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0) || a.data.title.localeCompare(b.data.title));
const featuredGames = allGames.slice(0, 8);

const toolCategories = [...new Set(allTools.map(t => t.data.category))].sort();
const gameCategories = [...new Set(allGames.map(g => g.data.category))].sort();
---

<LandingLayout lang={lang}>

  <!-- ── Header ── -->
  <header class="sticky top-0 z-40 bg-white dark:bg-[#161616] border-b border-slate-200 dark:border-[#393939]">
    <div class="max-w-6xl mx-auto px-4 h-14 flex items-center gap-6">
      <a href="/" class="flex items-center gap-2 font-bold text-base tracking-tight shrink-0">
        <svg width="22" height="22" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="32" height="32" rx="8" fill="#09090b"/>
          <path d="M9 21 L16 12 L23 21" stroke="#f8fafc" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="text-slate-900 dark:text-slate-100">ctrl</span><span class="text-cyan-600">cat</span>
      </a>
      <nav class="flex items-center gap-1" aria-label="Main navigation">
        <a href="/tools/"
           class="px-3 py-1.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-cyan-600 hover:bg-cyan-50 dark:hover:bg-cyan-950/30 rounded-md transition-colors">
          Tools
        </a>
        <a href="/games/"
           class="px-3 py-1.5 text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-violet-600 hover:bg-violet-50 dark:hover:bg-violet-950/30 rounded-md transition-colors">
          Games
        </a>
      </nav>
      <div class="ml-auto flex items-center gap-2 text-xs">
        <span class="px-2 py-1 rounded bg-slate-100 dark:bg-[#393939] text-slate-700 dark:text-slate-200 font-medium">EN</span>
        <a href="/ko/" class="px-2 py-1 rounded text-slate-500 hover:text-slate-700 hover:bg-slate-100 dark:hover:bg-[#393939] transition-colors">한국어</a>
      </div>
    </div>
  </header>

  <!-- ── Hero ── -->
  <section class="bg-slate-50 dark:bg-[#1c1b1f] border-b border-slate-200 dark:border-[#393939] py-14 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-cyan-600 mb-3">ctrlcat.dev</p>
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-slate-100 mb-3 tracking-tight leading-tight">
        {tr.landing.heroTitle}
      </h1>
      <p class="text-slate-500 dark:text-slate-400 text-sm mb-8 max-w-md mx-auto">{tr.landing.heroSub}</p>

      <!-- Search -->
      <div class="relative max-w-xl mx-auto mb-6">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input
          id="home-search"
          type="search"
          placeholder={tr.landing.searchPlaceholder}
          class="w-full bg-white dark:bg-[#262626] border border-slate-300 dark:border-[#525252] pl-11 pr-4 py-3
                 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-500 text-sm
                 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-all"
        />
      </div>

      <!-- Category pills -->
      <div class="flex flex-wrap justify-center gap-2">
        {toolCategories.map(cat => (
          <a href={`/tools/?cat=${cat}`}
             class="px-3 py-1 text-xs font-medium bg-white dark:bg-[#262626] border border-slate-200 dark:border-[#525252]
                    text-slate-600 dark:text-slate-300 hover:border-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-400 transition-colors">
            {tr.tools.categories_map[cat as keyof typeof tr.tools.categories_map] ?? cat}
          </a>
        ))}
        <span class="px-2 py-1 text-slate-300 text-xs self-center">|</span>
        {gameCategories.map(cat => (
          <a href={`/games/?cat=${cat}`}
             class="px-3 py-1 text-xs font-medium bg-white dark:bg-[#262626] border border-slate-200 dark:border-[#525252]
                    text-slate-600 dark:text-slate-300 hover:border-violet-400 hover:text-violet-700 dark:hover:text-violet-400 transition-colors">
            {tr.games.categories_map[cat as keyof typeof tr.games.categories_map] ?? cat}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Tools section ── -->
  <section class="max-w-6xl mx-auto px-4 py-12" id="section-tools" aria-label="Popular Tools">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-base font-semibold text-slate-900 dark:text-slate-100 uppercase tracking-wider">{tr.landing.featuredTools}</h2>
      <a href="/tools/"
         class="text-sm text-cyan-600 hover:text-cyan-700 font-medium transition-colors">
        {tr.landing.viewAllTools}
      </a>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-px bg-slate-200 dark:bg-[#393939] border border-slate-200 dark:border-[#393939]" id="home-tool-grid">
      {featuredTools.map(tool => (
        <a
          href={`/tools/${tool.slug}/`}
          data-title={tool.data.title.toLowerCase()}
          data-tags={tool.data.tags.join(" ").toLowerCase()}
          data-kind="tool"
          class="home-card group flex flex-col bg-white dark:bg-[#262626] p-4
                 hover:bg-cyan-50 dark:hover:bg-[#003a6d] transition-colors duration-150"
        >
          <div class="mb-3 text-cyan-600 dark:text-[#78a9ff]"><Icon name={tool.data.icon ?? ""} size={24} /></div>
          <div class="font-semibold text-sm text-slate-900 dark:text-slate-100 mb-1 leading-snug">
            {tool.data.title}
          </div>
          <div class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed flex-1">
            {tool.data.description}
          </div>
          <div class="mt-3 text-xs font-medium text-cyan-600 dark:text-[#78a9ff] group-hover:underline">
            {tr.landing.useTool}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-6xl mx-auto px-4">
    <div class="border-t border-slate-100 dark:border-[#393939]" />
  </div>

  <!-- ── Games section ── -->
  <section class="max-w-6xl mx-auto px-4 py-12" id="section-games" aria-label="Popular Games">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-base font-semibold text-slate-900 dark:text-slate-100 uppercase tracking-wider">{tr.landing.featuredGames}</h2>
      <a href="/games/"
         class="text-sm text-violet-600 hover:text-violet-700 font-medium transition-colors">
        {tr.landing.viewAllGames}
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="home-game-grid">
      {featuredGames.map(game => (
        <a
          href={`/games/${game.slug}/`}
          data-title={game.data.title.toLowerCase()}
          data-tags={game.data.tags.join(" ").toLowerCase()}
          data-kind="game"
          class="home-card group block rounded-3xl overflow-hidden
                 bg-white dark:bg-[#25232a] shadow-md-1
                 hover:shadow-md-3 transition-shadow duration-200"
        >
          <div class="flex items-center justify-center h-44 bg-white dark:bg-[#1c1b1f]">
            <GameIllustration slug={game.slug} />
          </div>
          <div class="px-5 py-4 border-t border-[#e7e0ec] dark:border-[#49454e]">
            <div class="font-bold text-sm text-slate-900 dark:text-[#e6e1e5] group-hover:text-violet-600 dark:group-hover:text-[#d0bcff] transition-colors">
              {game.data.title}
            </div>
            <div class="flex items-center justify-between mt-1.5">
              {game.data.playTime && (
                <span class="text-xs text-slate-400 dark:text-[#938f99]">~{game.data.playTime} min</span>
              )}
              <span class="text-xs font-semibold text-violet-600 dark:text-[#d0bcff] group-hover:underline ml-auto">
                {tr.landing.playGame}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── Footer ── -->
  <footer class="bg-slate-50 dark:bg-[#1c1b1f] border-t border-slate-200 dark:border-[#393939] mt-4">
    <div class="max-w-6xl mx-auto px-4 py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
        <div class="col-span-2 md:col-span-1">
          <div class="font-bold text-base text-slate-900 dark:text-slate-100 mb-2">
            ctrl<span class="text-cyan-600">cat</span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">{tr.landing.footerTagline}</p>
        </div>
        <div>
          <div class="text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-3">Tools</div>
          <ul class="space-y-2">
            {allTools.slice(0, 5).map(tool => (
              <li>
                <a href={`/tools/${tool.slug}/`}
                   class="text-xs text-slate-500 dark:text-slate-400 hover:text-cyan-600 transition-colors">
                  {tool.data.title}
                </a>
              </li>
            ))}
            <li>
              <a href="/tools/" class="text-xs text-cyan-600 hover:text-cyan-700 font-medium transition-colors">
                All tools
              </a>
            </li>
          </ul>
        </div>
        <div>
          <div class="text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-3">Games</div>
          <ul class="space-y-2">
            {allGames.slice(0, 5).map(game => (
              <li>
                <a href={`/games/${game.slug}/`}
                   class="text-xs text-slate-500 dark:text-slate-400 hover:text-violet-600 transition-colors">
                  {game.data.title}
                </a>
              </li>
            ))}
            <li>
              <a href="/games/" class="text-xs text-violet-600 hover:text-violet-700 font-medium transition-colors">
                All games
              </a>
            </li>
          </ul>
        </div>
        <div>
          <div class="text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-3">Site</div>
          <ul class="space-y-2">
            <li><a href="/ko/" class="text-xs text-slate-500 dark:text-slate-400 hover:text-slate-700 transition-colors">한국어</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-slate-200 dark:border-[#393939] pt-6 text-center text-xs text-slate-400">
        &copy; {new Date().getFullYear()} ctrlcat.dev — Free web tools and games
      </div>
    </div>
  </footer>

  <div id="home-no-results" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-sm px-4 py-2 shadow-lg z-50">
    No results found
  </div>

</LandingLayout>

<script>
  const searchInput = document.getElementById("home-search") as HTMLInputElement;
  const toolSection = document.getElementById("section-tools")!;
  const gameSection = document.getElementById("section-games")!;
  const noResults = document.getElementById("home-no-results")!;
  const allCards = document.querySelectorAll<HTMLAnchorElement>(".home-card");

  searchInput?.addEventListener("input", () => {
    const q = searchInput.value.toLowerCase().trim();
    if (!q) {
      allCards.forEach(c => c.style.display = "");
      toolSection.style.display = "";
      gameSection.style.display = "";
      noResults.classList.add("hidden");
      return;
    }
    let toolVisible = 0, gameVisible = 0;
    allCards.forEach(card => {
      const match = card.dataset.title?.includes(q) || card.dataset.tags?.includes(q);
      card.style.display = match ? "" : "none";
      if (match && card.dataset.kind === "tool") toolVisible++;
      if (match && card.dataset.kind === "game") gameVisible++;
    });
    toolSection.style.display = toolVisible > 0 ? "" : "none";
    gameSection.style.display = gameVisible > 0 ? "" : "none";
    noResults.classList.toggle("hidden", toolVisible + gameVisible > 0);
  });
</script>
