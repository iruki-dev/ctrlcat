---
import { getCollection } from "astro:content";
import GameLayout from "../../layouts/GameLayout.astro";
import Icon from "../../components/Icon.astro";
import { t } from "../../i18n";

const lang = "en";
const tr = t(lang);

const allGames = await getCollection("games", ({ data }) => data.status === "published");
allGames.sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0) || a.data.title.localeCompare(b.data.title));

const categories = [...new Set(allGames.map(g => g.data.category))].sort();
---

<GameLayout
  title={tr.games.pageTitle}
  description={tr.games.pageSubtitle}
  lang={lang}
  showHeader={false}
>
  <div class="mb-6">
    <h1 class="text-lg font-bold text-game-text">{tr.games.pageTitle}</h1>
    <p class="text-sm text-game-text-dim mt-0.5">{tr.games.pageSubtitle}</p>
  </div>

  <!-- Filter bar -->
  <div class="flex flex-col sm:flex-row gap-3 mb-6">
    <div class="relative flex-1 max-w-xs">
      <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-game-muted text-xs">⌕</span>
      <input
        id="game-search"
        type="search"
        placeholder={tr.games.search}
        class="w-full bg-game-surface border border-game-border rounded-md pl-7 pr-3 py-1.5
               text-game-text text-sm placeholder:text-game-muted
               focus:outline-none focus:ring-1 focus:ring-game-accent focus:border-game-accent transition-colors"
      />
    </div>
    <div class="flex gap-1.5 flex-wrap">
      <button
        data-filter="all"
        class="filter-btn px-2.5 py-1 text-xs rounded-md border border-game-accent text-game-accent bg-game-accent/10 font-medium"
      >
        {tr.games.all}
      </button>
      {categories.map(cat => (
        <button
          data-filter={cat}
          class="filter-btn px-2.5 py-1 text-xs rounded-md border border-game-border text-game-muted
                 hover:border-game-accent hover:text-game-accent font-medium transition-colors capitalize"
        >
          {tr.games.categories_map[cat as keyof typeof tr.games.categories_map] ?? cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Grid -->
  <div id="game-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3">
    {allGames.map(game => {
      const diffColor = ["", "text-green-600", "text-lime-600", "text-yellow-600", "text-orange-600", "text-red-600"][game.data.difficulty ?? 0] ?? "";
      return (
        <a
          href={`/games/${game.slug}/`}
          data-category={game.data.category}
          data-title={game.data.title.toLowerCase()}
          data-tags={game.data.tags.join(" ").toLowerCase()}
          class="game-card group flex flex-col gap-3 rounded-xl border border-game-border border-t-2 border-t-game-accent bg-game-surface p-4
                 hover:shadow-md transition-all duration-150"
        >
          <div class="flex items-start justify-between gap-2">
            <span class="text-game-accent"><Icon name={game.data.icon ?? ""} size={22} /></span>
            {game.data.featured && (
              <span class="shrink-0 text-2xs px-1.5 py-0.5 rounded border border-game-accent/30 text-game-accent bg-game-accent/5 font-medium uppercase tracking-wide">
                {tr.games.featured}
              </span>
            )}
          </div>
          <div class="flex-1">
            <div class="font-semibold text-sm text-game-text group-hover:text-game-accent transition-colors">
              {game.data.title}
            </div>
            <div class="text-xs text-game-text-dim mt-1 line-clamp-2 leading-relaxed">
              {game.data.description}
            </div>
          </div>
          <div class="mt-auto pt-3 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 text-xs">
              {game.data.difficulty && (
                <span class={`font-medium ${diffColor}`}>
                  {tr.games.difficulty[game.data.difficulty]}
                </span>
              )}
              {game.data.playTime && (
                <span class="text-game-muted">{tr.games.playTime(game.data.playTime)}</span>
              )}
            </div>
            <span class="text-xs font-semibold text-game-accent group-hover:underline shrink-0">
              {tr.landing.playGame}
            </span>
          </div>
        </a>
      );
    })}
  </div>

  <div id="game-empty" class="hidden py-20 text-center text-sm text-game-muted">
    {tr.games.noResults}
  </div>
</GameLayout>

<script>
  const search = document.getElementById("game-search") as HTMLInputElement;
  const empty = document.getElementById("game-empty")!;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".game-card");
  let activeCategory = "all";

  function update() {
    let visible = 0;
    const q = search.value.toLowerCase().trim();
    cards.forEach((card) => {
      const ok =
        (activeCategory === "all" || card.dataset.category === activeCategory) &&
        (!q || card.dataset.title!.includes(q) || card.dataset.tags!.includes(q));
      card.style.display = ok ? "" : "none";
      if (ok) visible++;
    });
    empty.classList.toggle("hidden", visible > 0);
  }

  search.addEventListener("input", update);
  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterBtns.forEach((b) => {
        b.classList.remove("border-game-accent", "text-game-accent", "bg-game-accent/10");
        b.classList.add("border-game-border", "text-game-muted");
      });
      btn.classList.add("border-game-accent", "text-game-accent", "bg-game-accent/10");
      btn.classList.remove("border-game-border", "text-game-muted");
      activeCategory = btn.dataset.filter!;
      update();
    });
  });
</script>
