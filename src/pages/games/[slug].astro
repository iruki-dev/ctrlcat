---
import { getCollection } from "astro:content";
import GameDetailView from "../../views/GameDetailView.astro";

export async function getStaticPaths() {
  const entries = await getCollection("games", ({ data }) => data.status === "published");
  return entries.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props;
---

<GameDetailView game={game} lang="en" />
