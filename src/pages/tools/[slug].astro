---
import { getCollection } from "astro:content";
import ToolDetailView from "../../views/ToolDetailView.astro";

export async function getStaticPaths() {
  const entries = await getCollection("tools", ({ data }) => data.status === "published");
  return entries.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props;
---

<ToolDetailView tool={tool} lang="en" />
